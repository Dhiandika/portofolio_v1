---
import { getTechIcon } from "../utils/techIcons";
import { getEntry } from 'astro:content';

interface Props {
    lang?: string;
}

const { lang = "en" } = Astro.props;

// Fetch Data from CMS
const techStackEntry = await getEntry('site', 'techstack');
const rawSkills = techStackEntry?.data?.skills || [];
const skillsData = rawSkills.map(skill => ({
    name: skill.name,
    icon: skill.icon || skill.name,
    category: skill.category
}));

// Split into two rows
const midpoint = Math.ceil(skillsData.length / 2);
const row1 = skillsData.slice(0, midpoint);
const row2 = skillsData.slice(midpoint);

function resolveIconUrl(name: string) {
    const extraIcons: Record<string, string> = {
        "Streamlit": "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/streamlit/streamlit-original.svg",
        "Express": "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/express/express-original.svg",
        "VSCode": "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/vscode/vscode-original.svg",
        "Github": "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/github/github-original.svg",
        "TensorFlow": "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/tensorflow/tensorflow-original.svg",
        "Keras": "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/keras/keras-original.svg",
        "Google Cloud": "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/googlecloud/googlecloud-original.svg",
    };
    if (extraIcons[name]) return extraIcons[name];
    return getTechIcon(name);
}

const ui = {
    en: { title: "Tech Stack", subtitle: "Tools & Technologies" },
    id: { title: "Keahlian", subtitle: "Alat & Teknologi" }
};
const t = ui[lang as keyof typeof ui] || ui.en;
---

<section data-aos="fade-up" class="border-4 border-black bg-white shadow-hard relative overflow-hidden">
    <!-- Window Header -->
    <div class="bg-neo-black text-white p-4 flex items-center justify-between border-b-4 border-black relative z-20">
        <div class="flex items-center gap-3">
            <i class="ri-code-box-fill text-2xl text-neo-yellow"></i>
            <div>
                <h2 class="text-xl font-black font-mono uppercase leading-none">{t.title}</h2>
                <p class="text-xs text-gray-400 font-mono tracking-widest">{t.subtitle}</p>
            </div>
        </div>
        <div class="w-3 h-3 bg-neo-green rounded-full border border-white animate-pulse"></div>
    </div>
    
    <div class="p-6 md:p-8 bg-white relative z-10">
        <div class="flex flex-col gap-6 w-full relative group">
            <!-- Row 1: Left to Right -->
            <div class="about-marquee-1 flex gap-4 md:gap-6 w-max whitespace-nowrap">
                {
                    [...row1, ...row1, ...row1, ...row1].map((skill) => (
                        <div class="flex items-center gap-3 bg-[#111] border-2 border-black rounded-full px-5 py-2.5 hover:border-neo-yellow transition-colors shadow-[2px_2px_0_0_#000] opacity-90 hover:opacity-100">
                            <div class="w-6 h-6 flex items-center justify-center bg-white/5 rounded-full p-1">
                                <img 
                                    src={resolveIconUrl(skill.icon)} 
                                    alt={skill.name} 
                                    class="w-full h-full object-contain filter drop-shadow-sm"
                                    onerror="this.onerror=null; this.src='https://cdn-icons-png.flaticon.com/512/1055/1055687.png';"
                                />
                            </div>
                            <span class="font-bold text-sm tracking-wide text-white">{skill.name}</span>
                        </div>
                    ))
                }
            </div>

            <!-- Row 2: Right to Left -->
            <div class="about-marquee-2 flex gap-4 md:gap-6 w-max whitespace-nowrap">
                {
                    [...row2, ...row2, ...row2, ...row2].map((skill) => (
                        <div class="flex items-center gap-3 bg-[#111] border-2 border-black rounded-full px-5 py-2.5 hover:border-neo-pink transition-colors shadow-[2px_2px_0_0_#000] opacity-90 hover:opacity-100">
                            <div class="w-6 h-6 flex items-center justify-center bg-white/5 rounded-full p-1">
                                <img 
                                    src={resolveIconUrl(skill.icon)} 
                                    alt={skill.name} 
                                    class="w-full h-full object-contain filter drop-shadow-sm"
                                    onerror="this.onerror=null; this.src='https://cdn-icons-png.flaticon.com/512/1055/1055687.png';"
                                />
                            </div>
                            <span class="font-bold text-sm tracking-wide text-white">{skill.name}</span>
                        </div>
                    ))
                }
            </div>
    </div>
</section>

<script>
    import { gsap } from "gsap";

    document.addEventListener("astro:page-load", () => {
        const row1 = document.querySelector(".about-marquee-1");
        const row2 = document.querySelector(".about-marquee-2");

        if (row1) {
            // 4 sets total, so 1 set = 25%. We shift by -25% to loop seamlessly.
            gsap.fromTo(
                row1,
                { xPercent: 0 },
                { xPercent: -25, repeat: -1, duration: 25, ease: "linear" }
            );
        }

        if (row2) {
            // Opposite direction: start at -25% and move to 0%
            gsap.fromTo(
                row2,
                { xPercent: -25 },
                { xPercent: 0, repeat: -1, duration: 25, ease: "linear" }
            );
        }
    });
</script>
