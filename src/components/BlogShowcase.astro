---
import { getCollection } from "astro:content";
import { getEntry } from "astro:content";
import { getMediumPosts } from "../utils/medium";

interface Props {
    lang?: string;
}

const { lang = "en" } = Astro.props;

const siteConfig = await getEntry("site", "config");
const { data: siteData } = siteConfig || {
    data: { mediumUsername: "dhiandika" },
};

// Fetch Local
const localPosts = await getCollection("blog");
const formattedLocalPosts = localPosts.map((post) => ({
    title:
        lang === "id" ? post.data.title_id || post.data.title : post.data.title,
    date: new Date(post.data.publishedDate),
    coverImage: post.data.coverImage,
    excerpt:
        lang === "id"
            ? post.data.excerpt_id || post.data.excerpt
            : post.data.excerpt,
    link: `/${lang}/blog/${post.slug}`,
    isExternal: false,
    topics: post.data.topics || [],
}));

// Fetch Medium
const mediumPostsRaw = await getMediumPosts(
    siteData.mediumUsername || "dhiandika",
);
const formattedMediumPosts = mediumPostsRaw.map((post) => ({
    title: post.title,
    date: new Date(post.pubDate),
    coverImage: post.thumbnail,
    excerpt: post.description, // Already stripped HTML in utility
    link: post.link,
    isExternal: true,
    topics: post.categories || [],
}));

// Merge & Sort
const allPosts = [...formattedLocalPosts, ...formattedMediumPosts]
    .sort((a, b) => b.date.valueOf() - a.date.valueOf())
    .slice(0, 3);

const ui = {
    en: {
        title: "LATEST_TRANSMISSION",
        readMore: "READ_DATA",
        viewAll: "VIEW_ARCHIVE",
    },
    id: {
        title: "TRANSMISI_TERBARU",
        readMore: "BACA_DATA",
        viewAll: "LIHAT_ARSIP",
    },
};

const t = ui[lang as keyof typeof ui] || ui.en;
---

<section
    id="blog"
    class="py-24 bg-white border-t-4 border-black px-4 relative overflow-hidden"
>
    <!-- Technical Grid Pattern -->
    <div
        class="absolute inset-0 opacity-10 pointer-events-none"
        style="background-image: linear-gradient(#000 1px, transparent 1px), linear-gradient(90deg, #000 1px, transparent 1px); background-size: 40px 40px;"
    >
    </div>

    <div class="max-w-7xl mx-auto relative z-10">
        <div class="flex justify-between items-end mb-16">
            <h2
                class="text-5xl md:text-8xl font-black uppercase tracking-tighter text-neo-black drop-shadow-[4px_4px_0_rgba(251,255,72,1)]"
            >
                {t.title}
            </h2>
            <a
                href={`/${lang}/blog`}
                class="hidden md:inline-block font-mono font-bold text-sm bg-neo-black text-white px-4 py-2 hover:bg-neo-purple transition-colors"
            >
                {t.viewAll} //
            </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {
                allPosts.map((post) => (
                    <article class="group border-4 border-black bg-neo-white shadow-hard hover:-translate-y-2 hover:shadow-[8px_8px_0_0_rgba(0,0,0,1)] transition-all duration-300">
                        <a
                            href={post.link}
                            target={post.isExternal ? "_blank" : "_self"}
                            class="block h-full flex flex-col"
                        >
                            {post.coverImage && (
                                <div class="h-48 border-b-4 border-black overflow-hidden relative">
                                    <div class="absolute inset-0 bg-neo-green/20 group-hover:bg-transparent transition-colors z-10" />
                                    <img
                                        src={post.coverImage}
                                        alt={post.title}
                                        class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500"
                                    />
                                    {post.isExternal && (
                                        <div class="absolute top-2 right-2 bg-black text-white text-xs font-mono px-2 py-1 z-20">
                                            MEDIUM
                                        </div>
                                    )}
                                </div>
                            )}
                            <div class="p-6 flex-1 flex flex-col">
                                <div class="font-mono text-xs mb-3 bg-black text-white inline-block px-2 py-0.5 w-max">
                                    {post.date.toLocaleDateString(
                                        lang === "id" ? "id-ID" : "en-US",
                                        {
                                            year: "numeric",
                                            month: "short",
                                            day: "numeric",
                                        },
                                    )}
                                </div>
                                <h3 class="text-2xl font-black mb-3 leading-tight group-hover:text-neo-purple transition-colors uppercase cursor-pointer">
                                    {post.title}
                                </h3>
                                <p class="text-sm font-mono text-gray-700 mb-6 line-clamp-3 flex-1">
                                    {post.excerpt}
                                </p>
                                {post.topics && post.topics.length > 0 && (
                                    <div class="flex flex-wrap gap-2 mb-6">
                                        {post.topics
                                            .slice(0, 3)
                                            .map((topic) => (
                                                <span class="text-xs font-mono font-bold bg-gray-200 px-2 py-1 rounded-none text-black border border-black hover:bg-neo-yellow transition-colors">
                                                    #{topic}
                                                </span>
                                            ))}
                                    </div>
                                )}
                                <div class="mt-auto border-t-2 border-black pt-4 flex justify-between items-center">
                                    <span class="font-bold text-sm text-neo-black group-hover:translate-x-1 transition-transform">
                                        {t.readMore}
                                    </span>
                                    <i
                                        class={`ri-${post.isExternal ? "external-link-line" : "arrow-right-line"} text-xl group-hover:translate-x-1 transition-transform`}
                                    />
                                </div>
                            </div>
                        </a>
                    </article>
                ))
            }
        </div>

        <div class="md:hidden mt-12 text-center">
            <a
                href={`/${lang}/blog`}
                class="inline-block bg-neo-black text-white px-8 py-4 font-bold font-mono border-4 border-transparent hover:border-black hover:bg-white hover:text-black transition-all shadow-hard"
            >
                {t.viewAll}
            </a>
        </div>
    </div>
</section>
