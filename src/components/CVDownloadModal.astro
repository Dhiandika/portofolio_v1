---
import { getEntry } from "astro:content";

interface Props {
    lang?: string;
}

const { lang = "en" } = Astro.props;
const siteConfig = await getEntry("site", "config");

const { 
    resume = "/assets/En_resume.pdf",
    resume_id = "/assets/Ind_resume.pdf"
} = siteConfig?.data || {};

const title = lang === "id" ? "PILIH BAHASA CV" : "CHOOSE CV LANGUAGE";
const englishText = lang === "id" ? "Bahasa Inggris (EN)" : "English (EN)";
const indonesianText = lang === "id" ? "Bahasa Indonesia (ID)" : "Indonesian (ID)";
---

<div id="cv-modal" class="fixed inset-0 z-[150] bg-black/70 backdrop-blur-sm hidden opacity-0 transition-opacity duration-200">
    <!-- Click backdrop to close -->
    <div class="absolute inset-0 z-0 cursor-default" id="cv-modal-backdrop"></div>
    
    <div class="relative w-full h-full pointer-events-none flex items-center justify-center p-4">
        <div id="cv-modal-content" class="pointer-events-auto relative z-10 w-full max-w-sm bg-white border-4 border-black shadow-[8px_8px_0_0_rgba(0,0,0,1)] overflow-hidden scale-95 transition-transform duration-200">
            <!-- Header -->
            <div class="bg-neo-black text-white px-4 py-3 border-b-4 border-black flex items-center justify-between">
                <span class="font-mono text-sm font-bold tracking-widest">{title}</span>
                <button id="cv-modal-close" class="hover:text-neo-pink transition-colors focus:outline-none cursor-hover">
                    <i class="ri-close-line text-2xl leading-none"></i>
                </button>
            </div>
            
            <!-- Body -->
            <div class="p-6 bg-dot-grid flex flex-col gap-4">
                <a href={resume} download data-astro-prefetch="false" rel="noopener noreferrer" class="group flex items-center justify-between bg-neo-yellow text-black border-4 border-black px-4 py-3 md:py-4 font-bold shadow-hard hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all cursor-hover w-full text-sm md:text-base">
                    <span>{englishText}</span>
                    <i class="ri-download-line text-xl group-hover:scale-110 transition-transform"></i>
                </a>
                
                <a href={resume_id} download data-astro-prefetch="false" rel="noopener noreferrer" class="group flex items-center justify-between bg-neo-white text-black border-4 border-black px-4 py-3 md:py-4 font-bold shadow-hard hover:bg-neo-pink hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all cursor-hover w-full text-sm md:text-base">
                    <span>{indonesianText}</span>
                    <i class="ri-download-line text-xl group-hover:scale-110 transition-transform"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    // Handle opening logic globally without using native <dialog> to avoid #top-layer overriding custom cursor z-index
    function initModal() {
        const triggers = document.querySelectorAll('[data-trigger="cv-modal"]');
        const modal = document.getElementById('cv-modal');
        const content = document.getElementById('cv-modal-content');
        const backdrop = document.getElementById('cv-modal-backdrop');
        const closeBtn = document.getElementById('cv-modal-close');
        
        if (!modal) return;
        
        const openModal = () => {
            modal.classList.remove('hidden');
            // Force reflow
            void modal.offsetWidth;
            
            modal.classList.remove('opacity-0');
            modal.classList.add('opacity-100');
            content?.classList.remove('scale-95');
            content?.classList.add('scale-100');
        };
        
        const closeModal = () => {
            modal.classList.remove('opacity-100');
            modal.classList.add('opacity-0');
            content?.classList.remove('scale-100');
            content?.classList.add('scale-95');
            
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 200);
        };

        // Remove old events and reattach
        triggers.forEach(btn => {
            // we clone trigger to clear old listeners if running multiple times (e.g., astro page transitions)
            const newBtn = btn.cloneNode(true);
            btn.parentNode?.replaceChild(newBtn, btn);
            newBtn.addEventListener('click', (e) => {
                e.preventDefault();
                openModal();
            });
        });

        const newBackdrop = backdrop?.cloneNode(true);
        backdrop?.parentNode?.replaceChild(newBackdrop as Node, backdrop as Node);
        newBackdrop?.addEventListener('click', closeModal);

        const newCloseBtn = closeBtn?.cloneNode(true);
        closeBtn?.parentNode?.replaceChild(newCloseBtn as Node, closeBtn as Node);
        newCloseBtn?.addEventListener('click', closeModal);
    }

    document.addEventListener('DOMContentLoaded', initModal);
    document.addEventListener('astro:page-load', initModal);
</script>
