<!-- Client-side script to fetch dynamic data for GitHub numbers -->
<script define:vars={{ githubUsername }}>
    // We can use the username passed from the server
    const username = githubUsername;

    async function fetchGitHubStats() {
        try {
            const response = await fetch(
                `https://api.github.com/users/${username}`,
            );
            const data = await response.json();

            const reposCount = document.getElementById("repos-count");
            const followersCount = document.getElementById("followers-count");
            const createdAt = document.getElementById("created-at");

            if (reposCount) reposCount.textContent = data.public_repos || "--";
            if (followersCount)
                followersCount.textContent = data.followers || "--";
            if (createdAt && data.created_at) {
                const date = new Date(data.created_at);
                createdAt.textContent = `${date.getFullYear()}`;
            }

            // Simple commit calculation logic or mock as real API key usually needed for events
            // Using a placeholder or simple logic if available
            const totalContributions = document.getElementById(
                "total-contributions",
            );
            const totalContributionsGrid = document.getElementById(
                "total-contributions-grid",
            );

            // Without a heavy API, we might just leave this or estimate.
            // For now, let's keep it static or remove if not easily fetchable without auth.
            // Actually, the previous code had static numbers, let's leave them as '--' or set a default.
            if (totalContributions) totalContributions.textContent = "1.2k+";
            if (totalContributionsGrid)
                totalContributionsGrid.textContent = "1.2k+";
        } catch (error) {
            console.error("Error fetching GitHub stats:", error);
        }
    }

    async function fetchGlobalViews() {
        try {
            const response = await fetch("/api/views/total");
            const data = await response.json();
            const viewsCount = document.getElementById("global-views-count");
            if (viewsCount && data.totalViews !== undefined) {
                viewsCount.textContent = data.totalViews.toLocaleString();
                viewsCount.classList.remove("opacity-50");
                viewsCount.classList.add("opacity-100");
                viewsCount.style.color = "#33FF57"; // Neo-green pop
            }
        } catch (error) {
            console.error("Error fetching global views:", error);
        }
    }

    // Run on both initial load and client-side navigations (View Transitions)
    document.addEventListener("astro:page-load", () => {
        fetchGitHubStats();
        fetchGlobalViews();
    });

    // Fallback for initial load if event listener attached too late
    if (
        document.readyState === "complete" ||
