---
import { getEntry } from "astro:content";
import { getCodingStats } from "../lib/coding-stats";

const { lang } = Astro.props;
const siteConfig = await getEntry("site", "config");
const {
    github = "https://github.com/Dhiandika",
    leetcode = "https://leetcode.com/Dhiandika_Aditya",
} = siteConfig?.data || {};

// Fetch Stats
const stats = await getCodingStats();
const waka = stats.wakatime;
const monkey = stats.monkeytype;

// Parse Usernames
const getGithubUsername = (url: string) => {
    try {
        const pathname = new URL(url).pathname;
        return pathname.split("/").filter(Boolean).pop() || "Dhiandika";
    } catch (e) {
        return "Dhiandika";
    }
};

const getLeetCodeUsername = (url: string) => {
    try {
        const pathname = new URL(url).pathname;
        // LeetCode URL format: /u/username/
        const parts = pathname.split("/").filter(Boolean);
        // If format is /u/username
        if (parts.includes("u")) {
            return parts[parts.indexOf("u") + 1] || "Dhiandika_Aditya";
        }
        return parts.pop() || "Dhiandika_Aditya";
    } catch (e) {
        return "Dhiandika_Aditya";
    }
};

const githubUsername = getGithubUsername(github);
const leetcodeUsername = getLeetCodeUsername(leetcode);

const ui = {
    en: {
        waka: "WAKATIME",
        monkey: "MONKEYTYPE",
        lastUpdate: "Last Updated",
        ago: "ago",
        startDate: "Start Date",
        endDate: "End Date",
        dailyAvg: "Daily Average",
        totalWeek: "This Week",
        bestDay: "Best Day",
        total: "Total Coding",
        langs: "Top Languages",
        joined: "Joined",
        streak: "Streak",
        tests: "Tests",
        time: "Time",
        leaderboard: "Leaderboards",
    },
    id: {
        waka: "WAKATIME",
        monkey: "MONKEYTYPE",
        lastUpdate: "Diperbarui",
        ago: "lalu",
        startDate: "Mulai",
        endDate: "Selesai",
        dailyAvg: "Rata-rata",
        totalWeek: "Minggu Ini",
        bestDay: "Hari Terbaik",
        total: "Total Coding",
        langs: "Bahasa",
        joined: "Bergabung",
        streak: "Streak",
        tests: "Tes",
        time: "Waktu",
        leaderboard: "Peringkat",
    },
};

const t = ui[lang as keyof typeof ui] || ui.en;

// Helper to format duration
const formatDuration = (seconds: number) => {
    const h = Math.floor(seconds / 3600);
    const m = Math.floor((seconds % 3600) / 60);
    return `${h}h ${m}m`;
};
