---
import { getCollection } from "astro:content";

const companies = await getCollection("companies");

// Ensure we have enough logos for a seamless loop
// If 1 logo, repeat 15 times. If 5 logos, repeat 3 times.
const minItems = 15;
const repeatCount = Math.ceil(minItems / Math.max(1, companies.length));
const displayCompanies = Array(repeatCount).fill(companies).flat();
---

<div
    class="w-full bg-neo-black py-8 border-y-4 border-black overflow-hidden relative z-20"
>
    <!-- Doubled for seamless loop -->
    <div
        class="logo-marquee flex gap-12 sm:gap-16 items-center w-max whitespace-nowrap"
    >
        {
            [...displayCompanies, ...displayCompanies].map((company) => (
                <a
                    href={company.data.link || "#"}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-4 opacity-50 hover:opacity-100 transition-opacity cursor-pointer group"
                >
                    <img
                        src={company.data.logo}
                        alt={company.data.name}
                        class="h-12 w-auto object-contain grayscale group-hover:grayscale-0 transition-all duration-300"
                    />
                </a>
            ))
        }
        {
            companies.length === 0 && (
                <div class="text-white font-mono opacity-50">NO SIGNAL_</div>
            )
        }
    </div>
</div>

<script>
    import { gsap } from "gsap";

    document.addEventListener("astro:page-load", () => {
        const marquee = document.querySelector(".logo-marquee");

        if (marquee) {
            // Move from Left (-50%) to Right (0%)
            // Duration is responsive to content length to maintain consistent speed
            // Single logo might be fast with fixed duration, so we use a base speed
            const speed = 40; // Lower = Faster

            gsap.fromTo(
                marquee,
                { xPercent: -50 },
                {
                    xPercent: 0,
                    repeat: -1,
                    duration: speed,
                    ease: "linear",
                },
            );
        }
    });
</script>
