---
import { getEntry } from "astro:content";

interface Props {
    lang?: string;
}

const { lang = "en" } = Astro.props;
const siteConfig = await getEntry("site", "config");
const { email = "npemburu6@gmail.com" } = siteConfig?.data || {};
const availabilityConfig = await getEntry("site", "availability");
const availabilityData = availabilityConfig?.data || {};

const { socials = [] } = availabilityData;

const ui = {
    en: {
        title: "Contact",
        subtitle: "Let's connect.",
        socialTitle: "Find me on social media",
        emailTitle: "Stay Connected",
        emailDesc: "Contact me via email for inquiries or collaboration.",
        emailBtn: "Go to Email",
        formTitle: "Or send me a message",
        namePlace: "Name",
        emailPlace: "Email",
        msgPlace: "Message",
        submitBtn: "Send Email"
    },
    id: {
        title: "Kontak",
        subtitle: "Mari saling terhubung.",
        socialTitle: "Temukan saya di media sosial",
        emailTitle: "Tetap Terhubung",
        emailDesc: "Hubungi saya melalui email untuk pertanyaan atau kolaborasi.",
        emailBtn: "Pergi ke Email",
        formTitle: "Atau kirimkan saya pesan",
        namePlace: "Name",
        emailPlace: "Email",
        msgPlace: "Message",
        submitBtn: "Kirim Email"
    },
};

const t = ui[lang as keyof typeof ui] || ui.en;

const socialCopy: Record<string, { title: { id: string; en: string }; desc: { id: string; en: string } }> = {
    instagram: { 
        title: { id: 'Ikuti Perjalanan Saya', en: 'Follow My Journey' }, 
        desc: { id: 'Ikuti perjalanan kreatif saya.', en: 'Follow my creative journey.' } 
    },
    linkedin: { 
        title: { id: 'Mari Terhubung', en: "Let's Connect" }, 
        desc: { id: 'Terhubung dengan saya secara profesional.', en: 'Connect with me professionally.' } 
    },
    tiktok: { 
        title: { id: 'Bergabung dalam Keseruan', en: 'Join the Fun' }, 
        desc: { id: 'Tonton konten yang menarik dan menyenangkan.', en: 'Watch engaging and fun content.' } 
    },
    github: { 
        title: { id: 'Jelajahi Kode', en: 'Explore Code' }, 
        desc: { id: 'Jelajahi karya sumber terbuka saya.', en: 'Explore my open source work.' } 
    },
    default: { 
        title: { id: 'Mari Terhubung', en: "Let's Connect" }, 
        desc: { id: 'Terhubung dengan saya di platform ini.', en: 'Connect with me on this platform.' } 
    }
};

function getSocialCopy(platform: string) {
    const key = platform.toLowerCase();
    return socialCopy[key] || socialCopy.default;
}
---

<section id="contact" class="py-20 bg-neo-white border-t-4 border-black relative overflow-hidden">
    <!-- Grid Decor Background -->
    <div class="absolute inset-0 opacity-10 pointer-events-none" style="background-image: linear-gradient(#000 1px, transparent 1px), linear-gradient(90deg, #000 1px, transparent 1px); background-size: 40px 40px;"></div>

    <div class="max-w-[1300px] mx-auto px-6 md:px-12 relative z-10">
        
        <!-- Header -->
        <div data-aos="fade-up" class="mb-12 md:mb-16">
            <h2 class="text-5xl md:text-6xl font-black uppercase tracking-tighter text-black">
                {t.title}
            </h2>
            <p class="font-mono mt-2 text-lg md:text-xl text-gray-700 font-bold">{t.subtitle}</p>
            <hr class="border-t-4 border-dashed border-black mt-8 opacity-50" />
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-stretch">
            
            <!-- Left: Social Media Bento Grid (Takes up 7 cols) -->
            <div data-aos="fade-up" class="lg:col-span-7 flex flex-col">
                <h3 class="font-bold font-mono uppercase mb-6 text-xl tracking-wide">/// {t.socialTitle}</h3>
                
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">


                    <!-- Dynamic Social Cards -->
                    {socials.map((social: any) => {
                        const copy = getSocialCopy(social.platform);
                        const title = lang === 'id' ? copy.title.id : copy.title.en;
                        const desc = lang === 'id' ? copy.desc.id : copy.desc.en;
                        const btnText = lang === 'id' ? `Pergi ke ${social.platform}` : `Go to ${social.platform}`;
                        
                        const bgClass = social.color ? `bg-${social.color}` : 'bg-neo-blue';
                        const textClass = ['neo-blue', 'neo-purple', 'neo-red', 'neo-pink', 'black'].includes(social.color || 'neo-blue') ? 'text-white' : 'text-black';
                        const iconColor = textClass === 'text-white' ? social.color || 'neo-blue' : 'black';

                        return (
                            <div class={`${bgClass} border-4 border-black shadow-[6px_6px_0_0_#000] p-6 hover:-translate-y-2 hover:shadow-[10px_10px_0_0_#000] transition-all group flex flex-col justify-between gap-6 relative overflow-hidden`}>
                                <i class={`${social.icon} absolute -bottom-6 -right-6 text-9xl opacity-10 pointer-events-none transform -rotate-12`}></i>
                                
                                <div class="relative z-10 flex flex-col gap-3 h-full">
                                    <div class="flex-grow">
                                        <h4 class={`text-xl font-black uppercase ${textClass} tracking-wide`}>{title}</h4>
                                        <p class={`font-mono ${textClass} text-xs font-bold mt-2 opacity-90 leading-relaxed`}>{desc}</p>
                                    </div>
                                    <a href={social.url} target="_blank" rel="noopener noreferrer" class={`mt-4 bg-white text-black font-bold font-mono px-4 py-2 border-4 border-black w-max flex items-center gap-2 hover:bg-black hover:text-white transition-colors shadow-[2px_2px_0_0_#000] active:translate-y-1 active:shadow-none text-sm`}>
                                        {btnText} <i class="ri-arrow-right-up-line"></i>
                                    </a>
                                </div>
                                
                                <div class="absolute top-6 right-6 w-12 h-12 bg-white border-4 border-black flex items-center justify-center rounded-lg shadow-[2px_2px_0_0_#000] group-hover:scale-110 group-hover:-rotate-6 transition-transform z-10">
                                    <i class={`${social.icon} text-3xl text-${iconColor}`}></i>
                                </div>
                            </div>
                        );
                    })}
                </div>
            </div>

            <!-- Right: Form Section (Takes up 5 cols) -->
            <div data-aos="fade-up" data-aos-delay="100" class="lg:col-span-5 flex flex-col">
                <h3 class="font-bold font-mono uppercase mb-6 text-xl tracking-wide">/// {t.formTitle}</h3>
                
                <form class="bg-white border-4 border-black shadow-[8px_8px_0_0_#000] p-6 md:p-8 flex flex-col flex-grow">
                    <div class="grid grid-cols-1 gap-6 mb-6">
                        <div class="group">
                            <label class="font-mono font-black mb-2 uppercase text-xs block group-focus-within:text-neo-blue transition-colors">
                                {t.namePlace} <span class="text-neo-red">*</span>
                            </label>
                            <input 
                                type="text" 
                                placeholder="Jhon Doe"
                                class="w-full bg-gray-50 border-4 border-black p-4 font-bold focus:outline-none focus:bg-neo-yellow focus:shadow-[4px_4px_0_0_#000] transition-all placeholder:text-gray-400"
                                required
                            />
                        </div>
                        <div class="group">
                            <label class="font-mono font-black mb-2 uppercase text-xs block group-focus-within:text-neo-blue transition-colors">
                                {t.emailPlace} <span class="text-neo-red">*</span>
                            </label>
                            <input 
                                type="email" 
                                placeholder="hello@example.com"
                                class="w-full bg-gray-50 border-4 border-black p-4 font-bold focus:outline-none focus:bg-neo-yellow focus:shadow-[4px_4px_0_0_#000] transition-all placeholder:text-gray-400"
                                required
                            />
                        </div>
                    </div>
                    <div class="group flex flex-col flex-grow min-h-[150px]">
                        <label class="font-mono font-black mb-2 uppercase text-xs block group-focus-within:text-neo-blue transition-colors">
                            {t.msgPlace} <span class="text-neo-red">*</span>
                        </label>
                        <textarea 
                            placeholder="Type your message here..."
                            class="w-full h-full bg-gray-50 border-4 border-black p-4 font-bold focus:outline-none focus:bg-neo-yellow focus:shadow-[4px_4px_0_0_#000] transition-all resize-none placeholder:text-gray-400 flex-grow"
                            required
                        ></textarea>
                    </div>
                    <button 
                        type="submit"
                        class="w-full bg-black text-white font-black text-xl py-4 mt-6 border-4 border-black hover:bg-neo-green hover:text-black transition-all shadow-[4px_4px_0_0_rgba(0,0,0,0.2)] hover:shadow-[6px_6px_0_0_#000] uppercase tracking-widest active:translate-y-1 active:shadow-none"
                    >
                        {t.submitBtn}
                    </button>
                </form>
            </div>

        </div>
    </div>
</section>
