---
import { getEntry } from "astro:content";

const { lang = "en" } = Astro.props;
const availabilityConfig = await getEntry("site", "availability");
const {
    status = "available",
    message = "Open for work",
    message_id,
    socials = [],
} = availabilityConfig?.data || {};

const displayMessage = lang === "id" ? message_id || message : message;

const statusColors = {
    available: "bg-neo-green",
    busy: "bg-neo-red",
    offline: "bg-gray-400",
};

const statusColor =
    statusColors[status as keyof typeof statusColors] || "bg-neo-green";
---

<div class="fixed bottom-20 right-4 z-[999] font-mono group">
    <!-- Main Toggle Button -->
    <button
        id="contact-toggle"
        class="bg-white border-4 border-black shadow-hard hover:shadow-hard-xl hover:-translate-y-1 transition-all duration-300 flex items-center gap-3 px-4 py-3"
    >
        <div
            class={`w-3 h-3 rounded-full ${statusColor} animate-pulse border border-black`}
        >
        </div>
        <span class="font-bold uppercase tracking-tight hidden md:inline-block">
            {status === "available" ? "ONLINE" : "STATUS"}
        </span>
        <i class="ri-message-3-fill text-xl"></i>
    </button>

    <!-- Expandable Panel -->
    <div
        id="contact-panel"
        class="absolute bottom-full right-0 mb-4 w-72 bg-white border-4 border-black shadow-hard-xl p-4 transform scale-90 opacity-0 pointer-events-none transition-all duration-300 origin-bottom-right"
    >
        <!-- Header -->
        <div
            class="flex justify-between items-center border-b-4 border-black pb-2 mb-4 bg-neo-black -mx-4 -mt-4 px-4 py-3 text-white"
        >
            <h3 class="font-black uppercase tracking-widest text-sm">
                COMM_LINK_V1
            </h3>
            <div class={`w-2 h-2 rounded-full ${statusColor}`}></div>
        </div>

        <!-- Status Message -->
        <div
            class="mb-4 bg-gray-100 border-2 border-black p-2 text-xs font-bold font-mono"
        >
            > {displayMessage}
            <span class="animate-pulse">_</span>
        </div>

        <!-- Social Links -->
        <div class="space-y-2">
            {
                socials.map((social: any) => (
                    <a
                        href={social.url}
                        target="_blank"
                        class={`block w-full text-left border-2 border-black px-3 py-2 text-sm font-bold uppercase transition-all hover:-translate-y-0.5 hover:shadow-md flex items-center justify-between group-hover/link:bg-${social.color}`}
                        style={`--hover-color: var(--${social.color || "neo-green"})`}
                    >
                        <span class="flex items-center gap-2">
                            <i class={social.icon} />
                            {social.platform}
                        </span>
                        <i class="ri-arrow-right-up-line opacity-0 group-hover:opacity-100 transition-opacity" />
                    </a>
                ))
            }
        </div>

        <!-- Footer -->
        <div
            class="mt-4 pt-2 border-t-2 border-black border-dashed flex justify-between text-[10px] text-gray-500 font-bold"
        >
            <span>SECURE_CONN</span>
            <span>ID: {Math.floor(Math.random() * 9999)}</span>
        </div>
    </div>
</div>

<script>
    const toggle = document.getElementById("contact-toggle");
    const panel = document.getElementById("contact-panel");

    let isOpen = false;

    toggle?.addEventListener("click", () => {
        isOpen = !isOpen;
        if (isOpen) {
            panel?.classList.remove(
                "scale-90",
                "opacity-0",
                "pointer-events-none",
            );
            panel?.classList.add(
                "scale-100",
                "opacity-100",
                "pointer-events-auto",
            );
            toggle.classList.add("bg-neo-yellow");
        } else {
            panel?.classList.add(
                "scale-90",
                "opacity-0",
                "pointer-events-none",
            );
            panel?.classList.remove(
                "scale-100",
                "opacity-100",
                "pointer-events-auto",
            );
            toggle.classList.remove("bg-neo-yellow");
        }
    });

    // Close when clicking outside
    document.addEventListener("click", (e) => {
        if (
            !toggle?.contains(e.target as Node) &&
            !panel?.contains(e.target as Node) &&
            isOpen
        ) {
            isOpen = false;
            panel?.classList.add(
                "scale-90",
                "opacity-0",
                "pointer-events-none",
            );
            panel?.classList.remove(
                "scale-100",
                "opacity-100",
                "pointer-events-auto",
            );
            toggle?.classList.remove("bg-neo-yellow");
        }
    });
</script>

<style>
    /* Dynamic hover colors using Tailwind classes doesn't always work with interpolation, 
       so we use a data attribute or predefined classes in global css if needed. 
       For now, let's stick to simple hover effects. */
    a:hover {
        background-color: var(--hover-color, #0f0);
    }
</style>
