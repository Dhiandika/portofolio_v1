---
import { getEntry } from "astro:content";
import HeroGeometric from "./HeroGeometric.astro";

interface Props {
    lang?: string;
}

const { lang = "en" } = Astro.props;
const heroConfig = await getEntry("site", "hero");
const siteConfig = await getEntry("site", "config");

const {
    title = "FULL STACK BRUTALIST",
    title_id,
    bio = "I build digital products.",
    bio_id,
    techStack = [],
} = heroConfig?.data || {};
const { resume = "/Assets/Resume/Arham%20Resume.pdf" } = siteConfig?.data || {};

const displayTitle = lang === "id" ? title_id || title : title;
const displayBio = lang === "id" ? bio_id || bio : bio;
---

<section
    class="min-h-screen flex flex-col justify-center items-center px-4 pt-24 pb-12 relative overflow-hidden border-b-4 border-black"
>
    <div
        class="absolute top-1/4 left-[5%] w-12 h-12 bg-neo-blue border-4 border-black shadow-hard animate-bounce hidden lg:block rotate-12"
    >
    </div>
    <div
        class="absolute bottom-1/4 right-[5%] w-20 h-20 bg-neo-pink rounded-full border-4 border-black shadow-hard hidden lg:block animate-pulse"
    >
    </div>
    <div
        class="absolute top-24 right-10 text-8xl opacity-5 font-black select-none pointer-events-none"
    >
        CODE
    </div>

    <HeroGeometric />

    <div class="relative z-10 text-center max-w-7xl mx-auto">
        <div
            class="inline-block bg-neo-white border-2 border-black px-4 py-1 mb-8 shadow-hard rotate-[-2deg] reveal"
        >
            <span class="font-mono font-bold text-neo-green bg-black px-2 mr-2"
                >●</span
            >
            <span class="font-mono font-bold text-sm md:text-base"
                >SYSTEM STATUS: ONLINE</span
            >
        </div>

        <h1
            class="text-[10vw] md:text-[6.5vw] leading-[0.85] font-black uppercase tracking-tighter mb-4 reveal mix-blend-darken whitespace-pre-line min-h-[1.6em]"
        >
            <span id="typewriter-text"
                >{displayTitle.replace(" DEVELOPER", "")}</span
            ><span class="animate-pulse">_</span>
            <span
                class="block text-stroke-black text-transparent md:text-black md:text-stroke-0"
                >DEVELOPER</span
            >
        </h1>

        <script>
            const roles = [
                "FULL STACK",
                "FRONTEND",
                "BACKEND",
                "SOFTWARE",
                "WEB",
                "UI/UX",
            ];
            let roleIndex = 0;
            let charIndex = 0;
            let isDeleting = false;
            let typeSpeed = 100;
            const textElement = document.getElementById("typewriter-text");

            function typeWriter() {
                if (!textElement) return;

                const currentRole = roles[roleIndex];

                let displayText = "";

                if (isDeleting) {
                    displayText = currentRole.substring(0, charIndex - 1);
                    charIndex--;
                    typeSpeed = 50;
                } else {
                    displayText = currentRole.substring(0, charIndex + 1);
                    charIndex++;
                    typeSpeed = 150;
                }

                textElement.innerHTML = displayText;

                if (!isDeleting && charIndex === currentRole.length) {
                    isDeleting = true;
                    typeSpeed = 2000;
                } else if (isDeleting && charIndex === 0) {
                    isDeleting = false;
                    roleIndex = (roleIndex + 1) % roles.length;
                    typeSpeed = 500;
                }

                setTimeout(typeWriter, typeSpeed);
            }

            // Start ONLY if we are in browser
            if (typeof window !== "undefined") {
                document.addEventListener("DOMContentLoaded", () => {
                    setTimeout(typeWriter, 1000);
                });
            }
        </script>

        <div
            class="flex flex-col items-center justify-center gap-6 max-w-2xl mx-auto mb-8"
        >
            <div
                class="bg-neo-yellow border-2 border-black p-5 shadow-hard reveal rotate-1 w-full relative group hover:rotate-0 transition-transform duration-300"
            >
                <!-- Decorative corner tabs -->
                <div class="absolute -top-3 -left-3 w-6 h-6 bg-black"></div>
                <div class="absolute -bottom-3 -right-3 w-6 h-6 bg-black"></div>

                <p
                    class="font-mono text-base md:text-lg mb-4 leading-relaxed relative z-10"
                >
                    {displayBio}
                </p>

                <div class="flex flex-wrap justify-center gap-2 relative z-10">
                    {
                        techStack.map((tech) => (
                            <span class="bg-white border-2 border-black px-2 py-1 font-bold shadow-sm hover:shadow-hard hover:-translate-y-1 transition-all cursor-default text-xs md:text-sm">
                                {tech.name}
                            </span>
                        ))
                    }
                </div>
            </div>
        </div>

        <div class="flex flex-col sm:flex-row justify-center gap-4 reveal px-4">
            <a
                href="#about"
                class="bg-black text-white border-2 border-black px-6 py-3 text-base md:text-lg font-bold shadow-hard hover:bg-neo-green hover:text-black hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all cursor-hover w-full sm:w-auto"
            >
                VIEW DETAILS
            </a>
            <button
                data-trigger="cv-modal"
                class="bg-neo-white text-black border-2 border-black px-6 py-3 text-base md:text-lg font-bold shadow-hard hover:bg-neo-pink hover:text-black hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all cursor-hover flex items-center justify-center gap-2 w-full sm:w-auto"
            >
                <i class="ri-download-line"></i> DOWNLOAD CV
            </button>
        </div>
        <br />
    </div>
</section>
