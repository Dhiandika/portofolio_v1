---
import { getEntry } from "astro:content";
import HeroGeometric from "./HeroGeometric.astro";

interface Props {
    lang?: string;
}

const { lang = "en" } = Astro.props;
const heroConfig = await getEntry("site", "hero");
const siteConfig = await getEntry("site", "config");
const aboutConfig = await getEntry("site", "whoami");

const {
    title = "FULL STACK BRUTALIST",
    title_id,
    techStack = [],
} = heroConfig?.data || {};

const {
    bio = "Creative Developer.",
    bio_id,
    profileImage = "/images/img.jpg",
} = aboutConfig?.data || {};

const { location = "Remote" } = siteConfig?.data || {};

const displayTitle = lang === "id" ? title_id || title : title;
const displayBio = lang === "id" ? bio_id || bio : bio;
---

<section
    id="about"
    class="min-h-screen flex flex-col justify-center px-8 md:px-16 lg:px-24 pt-24 lg:pt-32 pb-20 relative overflow-hidden border-b-4 border-black"
>
    <div
        class="absolute top-1/4 left-[5%] w-12 h-12 bg-neo-blue border-4 border-black shadow-hard animate-bounce hidden lg:block rotate-12"
    >
    </div>
    <div
        class="absolute bottom-1/4 right-[5%] w-20 h-20 bg-neo-pink rounded-full border-4 border-black shadow-hard hidden lg:block animate-pulse"
    >
    </div>
    <div
        class="absolute top-24 right-10 text-8xl opacity-5 font-black select-none pointer-events-none"
    >
        CODE
    </div>

    <HeroGeometric />

    <div class="relative z-10 max-w-7xl mx-auto w-full">
        <div
            class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-center"
        >
            <!-- 1. Left Column: Hero Typography & Info (Order 1 in mobile) -->
            <div
                data-aos="fade-right"
                class="order-1 lg:col-span-7 lg:col-start-1 lg:row-start-1 flex flex-col items-center lg:items-start text-center lg:text-left w-full"
            >
                <div
                    class="flex flex-wrap items-center gap-3 justify-center lg:justify-start mb-6 w-full reveal"
                >
                    <div
                        class="bg-neo-white border-2 border-black px-4 py-1 shadow-hard rotate-[-2deg]"
                    >
                        <span
                            class="font-mono font-bold text-neo-green bg-black px-2 mr-2"
                            >●</span
                        >
                        <span class="font-mono font-bold text-xs md:text-sm"
                            >SYSTEM STATUS: ONLINE</span
                        >
                    </div>
                    <div
                        class="bg-neo-black text-white px-4 py-1 font-mono text-xs md:text-sm border-2 border-black shadow-hard rotate-[1deg]"
                    >
                        📍 {location.toUpperCase()}
                    </div>
                </div>

                <h1
                    class="text-[10vw] sm:text-[8vw] lg:text-[4.5vw] xl:text-[5vw] leading-[0.85] font-black uppercase tracking-tighter mb-8 reveal mix-blend-darken whitespace-pre-line min-h-[1.6em]"
                >
                    <span id="typewriter-text"
                        >{displayTitle.replace(" DEVELOPER", "")}</span
                    ><span class="animate-pulse">_</span>
                    <span
                        class="block text-stroke-black text-transparent md:text-black md:text-stroke-0"
                        >DEVELOPER</span
                    >
                </h1>

                <script>
                    const roles = ["DATA SCIENCE", "FULL STACK", "WEB"];
                    let roleIndex = 0;
                    let charIndex = 0;
                    let isDeleting = false;
                    let typeSpeed = 100;
                    const textElement =
                        document.getElementById("typewriter-text");

                    function typeWriter() {
                        if (!textElement) return;

                        const currentRole = roles[roleIndex];
                        let displayText = "";

                        if (isDeleting) {
                            displayText = currentRole.substring(
                                0,
                                charIndex - 1,
                            );
                            charIndex--;
                            typeSpeed = 50;
                        } else {
                            displayText = currentRole.substring(
                                0,
                                charIndex + 1,
                            );
                            charIndex++;
                            typeSpeed = 150;
                        }

                        textElement.innerHTML = displayText;

                        if (!isDeleting && charIndex === currentRole.length) {
                            isDeleting = true;
                            typeSpeed = 2000;
                        } else if (isDeleting && charIndex === 0) {
                            isDeleting = false;
                            roleIndex = (roleIndex + 1) % roles.length;
                            typeSpeed = 500;
                        }

                        setTimeout(typeWriter, typeSpeed);
                    }

                    if (typeof window !== "undefined") {
                        document.addEventListener("DOMContentLoaded", () => {
                            setTimeout(typeWriter, 1000);
                        });
                    }
                </script>
            </div>

            <!-- 2. Right Column: Profile "Window" (Order 2 in mobile) -->
            <div
                data-aos="fade-left"
                class="order-2 lg:col-span-5 lg:col-start-8 lg:row-start-1 lg:row-span-2 reveal mt-4 mb-4 lg:my-0 flex justify-center lg:justify-end w-full"
            >
                <div
                    class="relative group w-full max-w-[18rem] md:max-w-sm mx-auto lg:mx-0"
                >
                    <!-- Decorative Elements -->
                    <div
                        class="absolute top-4 left-4 w-full h-full border-4 border-black bg-dot-grid z-0"
                    >
                    </div>

                    <div
                        class="relative bg-white border-4 border-black z-10 shadow-hard overflow-hidden flex flex-col h-full transform transition-transform hover:-translate-y-2 hover:-translate-x-2"
                    >
                        <!-- Sub Window Header (Mac Style) -->
                        <div
                            class="bg-neo-black text-white px-3 py-2 border-b-4 border-black flex items-center justify-between"
                        >
                            <div class="flex items-center gap-2">
                                <div
                                    class="w-3 h-3 bg-neo-red rounded-full border border-white"
                                >
                                </div>
                                <div
                                    class="w-3 h-3 bg-neo-yellow rounded-full border border-white"
                                >
                                </div>
                                <div
                                    class="w-3 h-3 bg-neo-green rounded-full border border-white"
                                >
                                </div>
                            </div>
                            <span
                                class="font-mono text-xs font-bold tracking-widest opacity-50 uppercase"
                            >
                                avatar_v1.0
                            </span>
                        </div>

                        <div
                            class="aspect-square relative overflow-hidden group"
                        >
                            <img
                                src={profileImage}
                                alt="Profile"
                                width="400"
                                height="400"
                                fetchpriority="high"
                                loading="eager"
                                class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
                                onerror="this.onerror=null; this.style.opacity='0';"
                            />

                            <!-- Tags/Badges -->
                            <span
                                class="absolute top-4 left-0 bg-neo-red text-white px-3 py-1 font-mono text-xs border-y-4 border-r-4 border-black font-bold shadow-md uppercase"
                            >
                                IDENTITY
                            </span>

                            <div
                                class="absolute bottom-4 right-4 bg-neo-black text-white p-2 border-2 border-white shadow-lg transform rotate-3"
                            >
                                <i class="ri-fingerprint-fill text-2xl"></i>
                            </div>
                        </div>
                    </div>

                    <!-- Tape Effect -->
                    <div
                        class="absolute -top-4 left-1/2 -translate-x-1/2 w-36 h-8 bg-yellow-200/90 transform -rotate-2 z-20 backdrop-blur-sm border-2 border-black/20 shadow-sm flex items-center justify-center font-handwriting text-sm text-black font-bold opacity-90 uppercase"
                    >
                        CONFIDENTIAL
                    </div>
                </div>
            </div>

            <!-- 3. Left Column Bottom: Bio & Buttons (Order 3 in mobile) -->
            <div
                class="order-3 lg:col-span-7 lg:col-start-1 lg:row-start-2 flex flex-col reveal w-full mt-4 lg:mt-0 xl:-mt-8"
            >
                <div class="mb-10 w-full">
                    <div
                        class="bg-neo-yellow border-2 border-black p-5 shadow-hard relative group hover:-translate-y-1 transition-transform w-full"
                    >
                        <!-- Decorative corner tabs -->
                        <div class="absolute -top-3 -left-3 w-6 h-6 bg-black">
                        </div>
                        <div
                            class="absolute -bottom-3 -right-3 w-6 h-6 bg-black"
                        >
                        </div>

                        <p
                            class="font-mono text-xs md:text-sm mb-5 leading-[1.8] text-gray-900 relative z-10"
                        >
                            {displayBio}
                        </p>

                        <div
                            class="flex flex-wrap justify-center lg:justify-start gap-2 relative z-10 w-full overflow-hidden"
                        >
                            {
                                techStack.map((tech) => (
                                    <span class="bg-white border-2 border-black px-2 py-1 font-bold shadow-sm hover:translate-y-1 transition-all cursor-default text-[10px] md:text-xs">
                                        {tech.name}
                                    </span>
                                ))
                            }
                        </div>
                    </div>
                </div>

                <div
                    class="flex flex-col sm:flex-row gap-4 w-full justify-center lg:justify-start"
                >
                    <a
                        href={`/${lang}/about`}
                        class="bg-black text-white border-2 border-black px-8 py-3 text-sm md:text-base font-bold neo-hover cursor-hover text-center uppercase"
                    >
                        {lang === "id" ? "Tentang Saya" : "View Details"}
                        <i class="ri-arrow-right-line ml-1"></i>
                    </a>
                    <button
                        data-trigger="cv-modal"
                        class="bg-neo-white text-black border-2 border-black px-8 py-3 text-sm md:text-base font-bold neo-hover cursor-hover flex items-center justify-center gap-2 uppercase"
                    >
                        <i class="ri-download-line text-xl"></i> DOWNLOAD CV
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>
