---
import { getEntry } from "astro:content";

interface Props {
    lang?: string;
}

const { lang = "en" } = Astro.props;
const heroConfig = await getEntry("site", "hero");
const siteConfig = await getEntry("site", "config");

const {
    title = "FULL STACK BRUTALIST",
    title_id,
    bio = "I build digital products.",
    bio_id,
    techStack = [],
} = heroConfig?.data || {};
const { resume = "/Assets/Resume/Arham%20Resume.pdf" } = siteConfig?.data || {};

const displayTitle = lang === "id" ? title_id || title : title;
const displayBio = lang === "id" ? bio_id || bio : bio;
---

<section
    class="min-h-screen flex flex-col justify-center items-center px-4 pt-20 relative overflow-hidden border-b-4 border-black"
>
    <div
        class="absolute top-1/3 left-[10%] w-16 h-16 bg-neo-blue border-4 border-black shadow-hard animate-bounce hidden lg:block rotate-12"
    >
    </div>
    <div
        class="absolute bottom-1/3 right-[10%] w-24 h-24 bg-neo-pink rounded-full border-4 border-black shadow-hard hidden lg:block animate-pulse"
    >
    </div>
    <div
        class="absolute top-20 right-20 text-9xl opacity-5 font-black select-none pointer-events-none"
    >
        CODE
    </div>

    <div class="relative z-10 text-center max-w-5xl">
        <div
            class="inline-block bg-neo-white border-2 border-black px-4 py-1 mb-6 shadow-hard rotate-[-2deg] reveal"
        >
            <span class="font-mono font-bold text-neo-green bg-black px-2 mr-2"
                >●</span
            >
            <span class="font-mono font-bold">SYSTEM STATUS: ONLINE</span>
        </div>

        <h1
            class="text-[10vw] md:text-[9vw] leading-none font-black uppercase tracking-tighter mb-6 reveal mix-blend-darken whitespace-pre-line min-h-[1.8em]"
        >
            <span id="typewriter-text"
                >{displayTitle.replace(" DEVELOPER", "")}</span
            ><span class="animate-pulse">_</span>
            DEVELOPER
        </h1>

        <script>
            const roles = [
                "FULL STACK",
                "FRONTEND",
                "BACKEND",
                "SOFTWARE",
                "WEB",
                "UI/UX"
            ];
            let roleIndex = 0;
            let charIndex = 0;
            let isDeleting = false;
            let typeSpeed = 100;
            const textElement = document.getElementById("typewriter-text");

            function typeWriter() {
                if (!textElement) return;

                const currentRole = roles[roleIndex];

                let displayText = "";

                if (isDeleting) {
                    displayText = currentRole.substring(0, charIndex - 1);
                    charIndex--;
                    typeSpeed = 50;
                } else {
                    displayText = currentRole.substring(0, charIndex + 1);
                    charIndex++;
                    typeSpeed = 150;
                }

                textElement.innerHTML = displayText;

                if (!isDeleting && charIndex === currentRole.length) {
                    isDeleting = true;
                    typeSpeed = 2000;
                } else if (isDeleting && charIndex === 0) {
                    isDeleting = false;
                    roleIndex = (roleIndex + 1) % roles.length;
                    typeSpeed = 500;
                }

                setTimeout(typeWriter, typeSpeed);
            }

            // Start ONLY if we are in browser
            if (typeof window !== "undefined") {
                document.addEventListener("DOMContentLoaded", () => {
                    setTimeout(typeWriter, 1000);
                });
            }
        </script>

        <div
            class="flex flex-wrap justify-center gap-4 max-w-2xl mx-auto mb-10 bg-neo-yellow border-2 border-black p-4 shadow-hard reveal rotate-1"
        >
            <p class="w-full font-mono text-lg md:text-xl mb-4">{displayBio}</p>
            <div class="flex flex-wrap justify-center gap-3">
                {
                    techStack.map((tech) => (
                        <span class="bg-white border-2 border-black px-3 py-1 font-bold shadow-sm hover:shadow-hard hover:-translate-y-1 transition-all cursor-default">
                            {tech.name}
                        </span>
                    ))
                }
            </div>
        </div>

        <div class="flex flex-col md:flex-row justify-center gap-6 reveal">
            <a
                href="#projects"
                class="bg-black text-white border-2 border-black px-10 py-5 text-xl font-bold shadow-hard hover:bg-neo-green hover:text-black hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all cursor-hover"
            >
                VIEW DATABASE
            </a>
            <a
                href={resume}
                download
                class="bg-neo-white text-black border-2 border-black px-10 py-5 text-xl font-bold shadow-hard hover:bg-neo-pink hover:text-black hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all cursor-hover flex items-center justify-center gap-2"
            >
                <i class="ri-download-line"></i> DOWNLOAD CV
            </a>
        </div>
        <br />
    </div>
</section>
