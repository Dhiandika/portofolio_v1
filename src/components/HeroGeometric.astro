---

---

<div
    class="absolute inset-0 z-0 pointer-events-none overflow-hidden select-none opacity-20"
>
    <!-- Rotating Dashed Circle -->
    <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] md:w-[700px] md:h-[700px] border border-dashed border-neo-black rounded-full animate-[spin_60s_linear_infinite]"
    >
    </div>

    <!-- Reverse Rotating Circle -->
    <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[300px] h-[300px] md:w-[450px] md:h-[450px] border border-neo-black rounded-full animate-[spin_40s_linear_infinite_reverse] opacity-50"
    >
    </div>

    <!-- Crosshairs -->
    <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-[1px] bg-neo-black/20"
    >
    </div>
    <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[1px] h-full bg-neo-black/20"
    >
    </div>

    <!-- Scanline Effect -->
    <div
        class="absolute inset-0 bg-[linear-gradient(rgba(18,18,18,0)_50%,rgba(0,0,0,0.05)_50%),linear-gradient(90deg,rgba(255,0,0,0.06),rgba(0,255,0,0.02),rgba(0,0,255,0.06))] z-10 bg-[length:100%_4px,3px_100%] pointer-events-none"
    >
    </div>

    <!-- Random Data Points -->
    <div
        class="absolute top-1/4 left-1/4 w-2 h-2 bg-neo-black rounded-full animate-pulse"
    >
    </div>
    <div
        class="absolute bottom-1/3 right-1/4 w-2 h-2 bg-neo-black rounded-full animate-ping"
    >
    </div>
</div>

<style>
    /* Ensure animations respect user preference */
    @media (prefers-reduced-motion: reduce) {
        .animate-[spin_60s_linear_infinite],
        .animate-[spin_40s_linear_infinite_reverse],
        .animate-pulse,
        .animate-ping {
            animation: none;
        }
    }
</style>
