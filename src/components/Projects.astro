---
import { getCollection } from "astro:content";
import { getEntry } from "astro:content";
import { getTechIcon, getTechColor, getTechAbbrev } from "../utils/techIcons";
import { getMediumPosts } from "../utils/medium";
import { Image } from "astro:assets";

interface Props { lang?: string; }
const { lang = "en" } = Astro.props;

const allProjects = await getCollection("projects");
// Sort by 'order' field (ascending) — set in Keystatic CMS, lower = first, default 99
const projects = allProjects.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const certificates = await getCollection("certificates");

const allDesigns = await getCollection("designs");
const designs = allDesigns.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const projectImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/**/*.{jpeg,jpg,png,gif,webp}');

// Blog posts
const siteConfig = await getEntry("site", "config");
const { data: siteData } = siteConfig || { data: { mediumUsername: "dhiandika" } };
const localPosts = await getCollection("blog");
const formattedLocalPosts = localPosts.map((post) => ({
    title: lang === "id" ? post.data.title_id || post.data.title : post.data.title,
    date: new Date(post.data.publishedDate),
    coverImage: post.data.coverImage,
    excerpt: lang === "id" ? post.data.excerpt_id || post.data.excerpt : post.data.excerpt,
    link: `/${lang}/blog/${post.slug}`,
    isExternal: false,
    topics: post.data.topics || [],
}));
const mediumPostsRaw = await getMediumPosts(siteData.mediumUsername || "dhiandika");
const formattedMediumPosts = mediumPostsRaw.map((post) => ({
    title: post.title,
    date: new Date(post.pubDate),
    coverImage: post.thumbnail,
    excerpt: post.description,
    link: post.link,
    isExternal: true,
    topics: post.categories || [],
}));
const allPosts = [...formattedLocalPosts, ...formattedMediumPosts]
    .sort((a, b) => b.date.valueOf() - a.date.valueOf());

const tabMeta = {
    projects: {
        en: { title: "Portfolio Showcase",   subtitle: `${projects.length} selected works — web, mobile & design.` },
        id: { title: "Portfolio Showcase",   subtitle: `${projects.length} karya pilihan — web, mobile & desain.` },
    },
    achievements: {
        en: { title: "Achievements",          subtitle: `${certificates.length} certifications, awards & milestones.` },
        id: { title: "Penghargaan",           subtitle: `${certificates.length} sertifikasi, penghargaan & pencapaian.` },
    },
    designs: {
        en: { title: "Graphic Designs",       subtitle: `${designs.length} creative artworks and posters.` },
        id: { title: "Desain Grafis",         subtitle: `${designs.length} karya seni dan poster kreatif.` },
    },
    blog: {
        en: { title: "Latest Transmission",  subtitle: `${allPosts.length} articles from local & Medium.` },
        id: { title: "Transmisi Terbaru",    subtitle: `${allPosts.length} artikel dari lokal & Medium.` },
    },
};

const ui = {
    en: { tabProjects: "Projects", tabAchievements: "Awards", tabDesigns: "Designs", tabBlog: "Blog", showMore: "Show More", liveDemo: "Live Demo", details: "Details →", readMore: "Read Post →", viewAll: "View All Projects", viewAllBlog: "View Archive", viewAllAch: "View All" },
    id: { tabProjects: "Proyek", tabAchievements: "Awards", tabDesigns: "Desain", tabBlog: "Blog", showMore: "Tampilkan", liveDemo: "Live Demo", details: "Detail →", readMore: "Baca Artikel →", viewAll: "Lihat Semua Proyek", viewAllBlog: "Lihat Arsip", viewAllAch: "Lihat Semua" },
};
const t = ui[lang as keyof typeof ui] || ui.en;
const initMeta = tabMeta.projects[lang as keyof typeof tabMeta.projects] || tabMeta.projects.en;

const INITIAL_SHOW = 9;
---

<section id="works" class="py-24 md:py-32 bg-neo-black px-4 relative overflow-hidden border-t-8 border-white">
    <!-- Anchor hooks for navbar hash links — do not remove -->
    <div id="achievements" style="position:absolute; top:-80px; left:0; height:0; width:0; visibility:hidden;"></div>
    <div id="designs" style="position:absolute; top:-80px; left:0; height:0; width:0; visibility:hidden;"></div>
    <div id="blog" style="position:absolute; top:-80px; left:0; height:0; width:0; visibility:hidden;"></div>
    <!-- Top stripe -->
    <div class="absolute top-0 left-0 w-full h-3 bg-neo-yellow border-b-4 border-black z-20"></div>
    <!-- Grid bg -->
    <div class="absolute inset-0 opacity-10 pointer-events-none" style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 40px 40px;"></div>

    <div class="max-w-7xl mx-auto relative z-10">

        <!-- Header — dynamic per tab -->
        <div class="text-center mb-10" data-aos="fade-up">
            <h2 id="section-title" class="text-5xl md:text-7xl font-black uppercase tracking-tighter text-white drop-shadow-[4px_4px_0_#FBFF48] mb-3">
                {initMeta.title}
            </h2>
            <p id="section-subtitle"
               class="font-mono text-white/50 text-sm max-w-xl mx-auto"
               data-projects={initMeta.subtitle}
               data-achievements={tabMeta.achievements[lang as keyof typeof tabMeta.achievements]?.subtitle || tabMeta.achievements.en.subtitle}
               data-designs={tabMeta.designs[lang as keyof typeof tabMeta.designs]?.subtitle || tabMeta.designs.en.subtitle}
               data-blog={tabMeta.blog[lang as keyof typeof tabMeta.blog]?.subtitle || tabMeta.blog.en.subtitle}
               data-title-projects={tabMeta.projects[lang as keyof typeof tabMeta.projects]?.title || tabMeta.projects.en.title}
               data-title-achievements={tabMeta.achievements[lang as keyof typeof tabMeta.achievements]?.title || tabMeta.achievements.en.title}
               data-title-designs={tabMeta.designs[lang as keyof typeof tabMeta.designs]?.title || tabMeta.designs.en.title}
               data-title-blog={tabMeta.blog[lang as keyof typeof tabMeta.blog]?.title || tabMeta.blog.en.title}
            >{initMeta.subtitle}</p>
        </div>

        <!-- Tab Navigation — 4 tabs -->
        <div class="flex mb-12 border-4 border-white w-max mx-auto overflow-hidden flex-wrap" data-aos="fade-up" data-aos-delay="100">
            <button
                id="tab-projects"
                class="tab-btn active-tab px-4 sm:px-6 py-3 font-black uppercase text-[10px] sm:text-xs tracking-widest transition-all border-b-4 sm:border-b-0 sm:border-r-4 border-white flex items-center gap-2 flex-grow justify-center"
                onclick="switchTab('projects')"
            >
                <i class="ri-briefcase-fill"></i> {t.tabProjects}
            </button>
            <button
                id="tab-achievements"
                class="tab-btn px-4 sm:px-6 py-3 font-black uppercase text-[10px] sm:text-xs tracking-widest transition-all border-b-4 sm:border-b-0 sm:border-r-4 border-white flex items-center gap-2 flex-grow justify-center"
                onclick="switchTab('achievements')"
            >
                <i class="ri-trophy-fill"></i> {t.tabAchievements}
            </button>
            <button
                id="tab-designs"
                class="tab-btn px-4 sm:px-6 py-3 font-black uppercase text-[10px] sm:text-xs tracking-widest transition-all sm:border-r-4 border-white flex items-center gap-2 flex-grow justify-center"
                onclick="switchTab('designs')"
            >
                <i class="ri-brush-fill"></i> {t.tabDesigns}
            </button>
            <button
                id="tab-blog"
                class="tab-btn px-4 sm:px-6 py-3 font-black uppercase text-[10px] sm:text-xs tracking-widest transition-all flex items-center gap-2 flex-grow justify-center"
                onclick="switchTab('blog')"
            >
                <i class="ri-article-fill"></i> {t.tabBlog}
            </button>
        </div>

        <!-- ═══════════ PROJECTS TAB ═══════════ -->
        <div id="panel-projects">
            <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-10">
                {await Promise.all(projects.map(async (project, index) => {
                    const title = lang === "id" ? project.data.title_id || project.data.title : project.data.title;
                    const description = lang === "id" ? project.data.description_id || project.data.description : project.data.description;
                    const techIconsList = project.data.techStack.map((tech: any) => ({
                        name: tech,
                        icon: getTechIcon(tech),
                        color: getTechColor(tech),
                        abbrev: getTechAbbrev(tech),
                    }));
                    const isHidden = index >= INITIAL_SHOW;
                    const detailHref = `/${lang}/projects/${project.id}`;
                    const DESC_LIMIT = 90;
                    const shortDesc = description && description.length > DESC_LIMIT
                        ? description.slice(0, DESC_LIMIT).trimEnd() + "..."
                        : description;
                    const categoryIcons: any = { "Web": "ri-global-line", "Mobile": "ri-smartphone-line", "UI/UX": "ri-pen-nib-line", "Other": "ri-code-s-slash-line" };
                    const catIcon = categoryIcons[project.data.category || "Web"] || "ri-code-s-slash-line";
                    // Fallback: use first gallery image if no thumbnail set
                    const thumbnailSrc = project.data.image
                        || (project.data.gallery?.find((g: string | null) => g !== null) ?? null);
                    
                    const imagePromise = thumbnailSrc ? projectImages[thumbnailSrc] : null;
                    const optimizedImage = imagePromise ? await imagePromise() : null;

                    return (
                        <article
                            data-aos="fade-up"
                            data-aos-delay={String((index % 3) * 80)}
                            class={`project-card group border-4 border-white bg-neo-black shadow-[6px_6px_0_0_#fff] hover:shadow-[10px_10px_0_0_#FBFF48] hover:border-neo-yellow transition-all duration-300 flex flex-col overflow-hidden${isHidden ? " hidden" : ""}`}
                        >
                            {/* Thumbnail */}
                            <div class="relative h-48 overflow-hidden border-b-4 border-white group-hover:border-neo-yellow transition-colors">
                                {optimizedImage ? (
                                    <Image
                                        src={optimizedImage.default}
                                        alt={title}
                                        width={600}
                                        height={400}
                                        format="webp"
                                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                                    />
                                ) : thumbnailSrc ? (
                                    <img
                                        src={thumbnailSrc}
                                        alt={title}
                                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                                        onerror="this.onerror=null;this.parentElement.querySelector('.no-img-placeholder').style.display='flex';this.style.display='none';"
                                    />
                                ) : null}
                                <div
                                    class={`no-img-placeholder w-full h-full flex-col items-center justify-center bg-gray-900 gap-2${thumbnailSrc ? " hidden" : " flex"}`}
                                    style="display: flex;"
                                >
                                    <span class="text-5xl font-black text-white/20 uppercase">{title.charAt(0)}</span>
                                    <span class="text-[10px] font-mono text-white/20 uppercase tracking-widest">No Preview</span>
                                </div>
                                <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent pointer-events-none"></div>
                                {/* Category badge */}
                                <span class="absolute top-3 left-3 flex items-center gap-1 bg-neo-yellow text-black text-[10px] font-black px-2 py-1 uppercase tracking-widest border-2 border-black">
                                    <i class={catIcon + " text-xs"}></i> {project.data.category || "Web"}
                                </span>
                            </div>

                            {/* Info */}
                            <div class="flex flex-col flex-1 p-5">
                                <h3 class="text-base font-black text-white uppercase leading-tight mb-1.5 group-hover:text-neo-yellow transition-colors">
                                    {title}
                                </h3>
                                <p class="font-mono text-white/45 text-[11px] leading-relaxed mb-4 flex-1">
                                    {shortDesc}
                                    {description && description.length > DESC_LIMIT && (
                                        <a href={detailHref} class="text-neo-yellow ml-1 hover:underline font-bold">Read more <span class="sr-only">about {title}</span></a>
                                    )}
                                </p>

                                {/* Tech stack icons — colored badge as base, CDN icon on top */}
                                <div class="flex flex-wrap gap-1.5 mb-4">
                                    {techIconsList.slice(0, 5).map((item: any) => (
                                        <div
                                            class="w-7 h-7 border border-black/30 flex items-center justify-center text-[8px] font-black overflow-hidden"
                                            style={`background:${item.color.bg}; color:${item.color.text};`}
                                            title={item.name}
                                            data-abbrev={item.abbrev}
                                        >
                                            {item.icon ? (
                                                <img
                                                    src={item.icon}
                                                    alt={item.name}
                                                    class="w-4 h-4 object-contain"
                                                    onerror={`this.style.display='none';this.parentElement.textContent=this.parentElement.dataset.abbrev;`}
                                                    loading="lazy"
                                                />
                                            ) : item.abbrev}
                                        </div>
                                    ))}
                                    {techIconsList.length > 5 && (
                                        <span class="w-7 h-7 bg-white/10 border border-white/20 flex items-center justify-center text-white/60 text-[9px] font-black">+{techIconsList.length - 5}</span>
                                    )}
                                </div>

                                {/* Actions */}
                                <div class="flex gap-2 mt-auto border-t-2 border-white/10 pt-3">
                                    {project.data.githubLink ? (
                                        <a
                                            href={project.data.githubLink}
                                            target="_blank"
                                            class="flex-1 text-center py-2 font-black text-[11px] uppercase tracking-widest border-2 border-white/50 text-white/70 hover:bg-white hover:text-black transition-all flex items-center justify-center gap-1"
                                        >
                                            <i class="ri-github-fill text-sm"></i> GitHub
                                        </a>
                                    ) : project.data.link ? (
                                        <a
                                            href={project.data.link}
                                            target="_blank"
                                            class="flex-1 text-center py-2 font-black text-[11px] uppercase tracking-widest border-2 border-white/50 text-white/70 hover:bg-white hover:text-black transition-all flex items-center justify-center gap-1"
                                        >
                                            <i class="ri-external-link-line text-sm"></i> Demo
                                        </a>
                                    ) : <span class="flex-1"></span>}
                                    <a
                                        href={detailHref}
                                        class="flex-1 py-2 font-black text-[11px] uppercase tracking-widest bg-neo-yellow text-black border-2 border-neo-yellow hover:bg-transparent hover:text-neo-yellow transition-all text-center flex items-center justify-center gap-1"
                                    >
                                        <i class="ri-eye-line"></i> {t.details} <span class="sr-only">about {title}</span>
                                    </a>
                                </div>
                            </div>
                        </article>
                    );
                }))}
            </div>



            <!-- Show More / View All -->
            <div class="flex flex-row flex-wrap justify-center items-center gap-4">
                {projects.length > INITIAL_SHOW && (
                    <button
                        id="show-more-btn"
                        class="flex items-center gap-2 px-8 py-3 bg-transparent border-4 border-white text-white font-black uppercase text-xs tracking-widest hover:bg-white hover:text-black transition-all"
                        onclick="showMoreProjects()"
                    >
                        <i class="ri-add-line text-sm"></i> {t.showMore} <span id="remaining-count" class="bg-neo-yellow text-black px-2 py-0.5 text-[10px] ml-1">{projects.length - INITIAL_SHOW}</span>
                    </button>
                )}
                <a href={`/${lang}/projects`} class="font-mono text-white/50 text-xs hover:text-white transition-colors underline flex items-center gap-1">
                    {t.viewAll} ({projects.length}) <i class="ri-arrow-right-line"></i>
                </a>
            </div>
        </div>

        <!-- ═══════════ ACHIEVEMENTS TAB ═══════════ -->
        <div id="panel-achievements" class="hidden">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
                {certificates.map((cert, index) => {
                    const title = lang === 'id' ? cert.data.title_id || cert.data.title : cert.data.title;
                    const description = lang === 'id' ? cert.data.description_id || cert.data.description : cert.data.description;
                    const isHidden = index >= INITIAL_SHOW;
                    const achCategoryIcons: any = { "Course": "ri-book-read-line", "Bootcamp": "ri-terminal-box-line", "Event": "ri-calendar-event-line", "Competition": "ri-medal-line" };
                    const catIcon = achCategoryIcons[cert.data.category || "Course"] || "ri-award-line";
                    const skills = cert.data.skills_verified || [];
                    return (
                        <article
                            data-aos="fade-up"
                            data-aos-delay={String((index % 3) * 80)}
                            class={`achievement-card group border-4 border-white bg-neo-black shadow-[6px_6px_0_0_#fff] hover:shadow-[10px_10px_0_0_#3BFF7E] hover:border-neo-green transition-all duration-300 flex flex-col overflow-hidden${isHidden ? " hidden" : ""}`}
                        >
                            {cert.data.image ? (
                                <div class="relative h-48 overflow-hidden border-b-4 border-white group-hover:border-neo-green transition-colors">
                                    <img src={cert.data.image} alt={title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" onerror="this.onerror=null;this.style.opacity='0';" />
                                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
                                    <span class="absolute top-3 left-3 flex items-center gap-1 bg-neo-green text-black text-[10px] font-black px-2 py-1 uppercase tracking-widest border-2 border-black">
                                        <i class={catIcon + " text-xs"}></i> {cert.data.category || 'Course'}
                                    </span>
                                </div>
                            ) : (
                                <div class="relative h-32 overflow-hidden border-b-4 border-white group-hover:border-neo-green transition-colors bg-gradient-to-br from-gray-800 to-black flex flex-col items-center justify-center pt-2">
                                    <i class={`${catIcon} text-6xl text-white/10 group-hover:text-neo-green/20 transition-colors duration-500 absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2`}></i>
                                    <div class="z-10 flex flex-col items-center gap-1">
                                        <span class="text-[9px] font-mono font-bold text-neo-green tracking-widest uppercase bg-black px-2 py-0.5 border border-neo-green">Verified</span>
                                    </div>
                                    <span class="absolute top-3 left-3 flex items-center gap-1 bg-neo-green text-black text-[10px] font-black px-2 py-1 uppercase tracking-widest border-2 border-black">
                                        <i class={catIcon + " text-xs"}></i> {cert.data.category || 'Course'}
                                    </span>
                                </div>
                            )}
                            <div class="flex flex-col flex-1 p-5 relative z-10">
                                <div class="font-mono text-[10px] text-white/40 mb-2 uppercase">{cert.data.date} · {cert.data.issuer}</div>
                                <h3 class="text-base font-black text-white uppercase leading-tight mb-2 group-hover:text-neo-green transition-colors line-clamp-2">{title}</h3>
                                <p class="font-mono text-white/45 text-[11px] leading-relaxed mb-4 flex-1">{description}</p>
                                
                                {cert.data.credentialId && (
                                    <div class="font-mono text-[9px] text-white/30 uppercase mt-auto mb-3">ID: {cert.data.credentialId}</div>
                                )}
                                
                                {skills.length > 0 && (
                                    <div class="flex flex-wrap gap-1.5 mb-4">
                                        {skills.slice(0, 4).map((skill: string) => (
                                            <span class="text-[9px] font-mono font-bold border border-white/20 text-white/50 px-2 py-0.5">#{skill}</span>
                                        ))}
                                        {skills.length > 4 && (
                                            <span class="text-[9px] font-mono font-bold border border-white/20 text-white/50 px-2 py-0.5">+{skills.length - 4}</span>
                                        )}
                                    </div>
                                )}

                                <div class="mt-auto border-t-2 border-white/10 pt-3 flex justify-between items-center">
                                    {cert.data.link ? (
                                        <a href={cert.data.link} target="_blank" class="font-black text-[11px] uppercase tracking-widest text-neo-green hover:underline flex items-center gap-1">
                                            View Credential <i class="ri-external-link-line"></i>
                                        </a>
                                    ) : <span></span>}
                                </div>
                            </div>
                        </article>
                    );
                })}
            </div>
            <div class="flex flex-row flex-wrap justify-center items-center gap-4">
                {certificates.length > INITIAL_SHOW && (
                    <button id="show-more-ach-btn" class="flex items-center gap-2 px-8 py-3 bg-transparent border-4 border-white text-white font-black uppercase text-xs tracking-widest hover:bg-white hover:text-black transition-all" onclick="showMoreAchievements()">
                        <i class="ri-add-line text-sm"></i> {t.showMore} <span id="remaining-ach-count" class="bg-neo-green text-black px-2 py-0.5 text-[10px] ml-1">{certificates.length - INITIAL_SHOW}</span>
                    </button>
                )}
                <a href={`/${lang}/achievements`} class="font-mono text-white/50 text-xs hover:text-white transition-colors underline flex items-center gap-1">
                    {t.viewAllAch} ({certificates.length}) <i class="ri-arrow-right-line"></i>
                </a>
            </div>
        </div>

        <!-- ═══════════ DESIGNS TAB ═══════════ -->
        <div id="panel-designs" class="hidden">
            <div id="designs-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-10">
                {designs.map((design, index) => {
                    const title = lang === "id" && design.data.title_id ? design.data.title_id : design.data.title;
                    const description = lang === "id" && design.data.description_id ? design.data.description_id : design.data.description;
                    const isHidden = index >= INITIAL_SHOW;
                    return (
                        <article
                            data-aos="fade-up"
                            data-aos-delay={String((index % 3) * 80)}
                            class={`design-card group border-4 border-white bg-neo-black shadow-[6px_6px_0_0_#fff] hover:shadow-[10px_10px_0_0_#FF2D78] hover:border-neo-pink transition-all duration-300 flex flex-col overflow-hidden${isHidden ? " hidden" : ""}`}
                        >
                            <div class="relative h-64 overflow-hidden border-b-4 border-white group-hover:border-neo-pink transition-colors">
                                <img src={design.data.image} alt={title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
                                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4">
                                    {design.data.link && (
                                        <a href={design.data.link} target="_blank" class="text-white font-black uppercase tracking-widest text-xs border-2 border-white px-3 py-1.5 hover:bg-white hover:text-black transition-colors flex items-center gap-2">
                                            View Details <i class="ri-external-link-line"></i>
                                        </a>
                                    )}
                                </div>
                            </div>
                            <div class="flex flex-col flex-1 p-5">
                                <h3 class="text-base font-black text-white uppercase leading-tight mb-2 group-hover:text-neo-pink transition-colors line-clamp-2">{title}</h3>
                                {description && <p class="font-mono text-white/45 text-[11px] leading-relaxed mb-4 line-clamp-2">{description}</p>}
                                <div class="mt-auto pt-2 flex flex-wrap gap-1.5">
                                    {design.data.tools?.map((tool: string) => (
                                        <span class="text-[9px] font-mono font-bold bg-white/10 text-white px-2 py-0.5 border border-white/20">{tool}</span>
                                    ))}
                                </div>
                            </div>
                        </article>
                    );
                })}
            </div>
            <div class="flex flex-row flex-wrap justify-center items-center gap-4">
                {designs.length > INITIAL_SHOW && (
                    <button id="show-more-designs-btn" class="flex items-center gap-2 px-8 py-3 bg-transparent border-4 border-white text-white font-black uppercase text-xs tracking-widest hover:bg-white hover:text-black transition-all" onclick="showMoreDesigns()">
                        <i class="ri-add-line text-sm"></i> {t.showMore} <span id="remaining-designs-count" class="bg-neo-pink text-black px-2 py-0.5 text-[10px] ml-1">{designs.length - INITIAL_SHOW}</span>
                    </button>
                )}
            </div>
        </div>

        <!-- ═══════════ BLOG TAB ═══════════ -->
        <div id="panel-blog" class="hidden">
            <div id="blog-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-10">
                {allPosts.map((post, index) => {
                    const isHidden = index >= INITIAL_SHOW;
                    return (
                        <article
                            data-aos="fade-up"
                            data-aos-delay={String((index % 3) * 80)}
                            class={`blog-card group border-4 border-white bg-neo-black shadow-[6px_6px_0_0_#fff] hover:shadow-[10px_10px_0_0_rgba(251,255,72,1)] hover:border-neo-yellow transition-all duration-300 flex flex-col overflow-hidden${isHidden ? " hidden" : ""}`}
                        >
                            <a href={post.link} target={post.isExternal ? "_blank" : "_self"} class="flex flex-col flex-1 h-full">
                                {/* Thumbnail */}
                                <div class="relative h-48 overflow-hidden border-b-4 border-white group-hover:border-neo-yellow transition-colors">
                                    {post.coverImage ? (
                                        <img src={post.coverImage} alt={post.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
                                    ) : (
                                        <div class="w-full h-full flex items-center justify-center bg-gray-900">
                                            <i class="ri-article-line text-5xl text-white/20"></i>
                                        </div>
                                    )}
                                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
                                    <span class="absolute top-3 left-3 flex items-center gap-1 bg-neo-yellow text-black text-[10px] font-black px-2 py-1 uppercase tracking-widest border-2 border-black">
                                        <i class={post.isExternal ? "ri-medium-fill text-xs" : "ri-quill-pen-line text-xs"}></i> {post.isExternal ? "Medium" : "Blog"}
                                    </span>
                                </div>

                                {/* Info */}
                                <div class="flex flex-col flex-1 p-5">
                                    <div class="font-mono text-[10px] text-white/40 mb-2 uppercase">
                                        {post.date.toLocaleDateString(lang === "id" ? "id-ID" : "en-US", { year: "numeric", month: "short", day: "numeric" })}
                                    </div>
                                    <h3 class="text-base font-black text-white uppercase leading-tight mb-2 group-hover:text-neo-yellow transition-colors line-clamp-2">
                                        {post.title}
                                    </h3>
                                    <p class="font-mono text-white/45 text-[11px] leading-relaxed mb-4 line-clamp-2 flex-1">
                                        {post.excerpt}
                                    </p>
                                    {post.topics.length > 0 && (
                                        <div class="flex flex-wrap gap-1.5 mb-4">
                                            {post.topics.slice(0, 3).map((topic) => (
                                                <span class="text-[9px] font-mono font-bold border border-white/20 text-white/50 px-2 py-0.5">#{topic}</span>
                                            ))}
                                        </div>
                                    )}
                                    <div class="mt-auto border-t-2 border-white/10 pt-3 flex justify-between items-center">
                                        <span class="font-black text-[11px] uppercase tracking-widest text-neo-yellow">{t.readMore}</span>
                                        <i class={`ri-${post.isExternal ? "external-link-line" : "arrow-right-line"} text-white group-hover:translate-x-1 transition-transform`}></i>
                                    </div>
                                </div>
                            </a>
                        </article>
                    );
                })}
            </div>

            <div class="flex flex-row flex-wrap justify-center items-center gap-4">
                {allPosts.length > INITIAL_SHOW && (
                    <button
                        id="show-more-blog-btn"
                        class="flex items-center gap-2 px-8 py-3 bg-transparent border-4 border-white text-white font-black uppercase text-xs tracking-widest hover:bg-white hover:text-black transition-all"
                        onclick="showMoreBlog()"
                    >
                        <i class="ri-add-line text-sm"></i> {t.showMore} <span id="remaining-blog-count" class="bg-neo-yellow text-black px-2 py-0.5 text-[10px] ml-1">{allPosts.length - INITIAL_SHOW}</span>
                    </button>
                )}
                <a href={`/${lang}/blog`} class="font-mono text-white/50 text-xs hover:text-white transition-colors underline flex items-center gap-1">
                    {t.viewAllBlog} ({allPosts.length}) <i class="ri-arrow-right-line"></i>
                </a>
            </div>
        </div>

    </div>
</section>

<style>
    .tab-btn { background: transparent; color: rgba(255,255,255,0.5); cursor: pointer; }
    .tab-btn:hover { background: rgba(255,255,255,0.05); color: white; }
    .active-tab { background: #FBFF48 !important; color: #000 !important; }
    .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
</style>

<script is:inline>
    // ── Dynamic title/subtitle per tab
    function switchTab(tab) {
        const panels = { projects: document.getElementById('panel-projects'), achievements: document.getElementById('panel-achievements'), designs: document.getElementById('panel-designs'), blog: document.getElementById('panel-blog') };
        const tabs   = { projects: document.getElementById('tab-projects'),   achievements: document.getElementById('tab-achievements'),   designs: document.getElementById('tab-designs'), blog: document.getElementById('tab-blog')   };
        Object.keys(panels).forEach(k => {
            if (panels[k]) panels[k].classList.toggle('hidden', k !== tab);
            if (tabs[k]) tabs[k].classList.toggle('active-tab', k === tab);
        });
        const subtitleEl = document.getElementById('section-subtitle');
        const titleEl    = document.getElementById('section-title');
        if (titleEl && subtitleEl) {
            titleEl.textContent    = subtitleEl.dataset['title' + tab.charAt(0).toUpperCase() + tab.slice(1)] || titleEl.textContent;
            subtitleEl.textContent = subtitleEl.dataset[tab] || '';
        }
        
        refreshLayout();
    }

    function refreshLayout() {
        setTimeout(() => {
            if (typeof window.AOS !== 'undefined') window.AOS.refresh();
            if (typeof window.ScrollTrigger !== 'undefined') window.ScrollTrigger.refresh();
            window.dispatchEvent(new Event('scroll'));
        }, 100);
    }

    // ── Show More Projects
    function showMoreProjects() {
        const cards = document.querySelectorAll('.project-card.hidden');
        Array.from(cards).slice(0, 9).forEach(c => c.classList.remove('hidden'));
        const remaining = document.querySelectorAll('.project-card.hidden').length;
        const btn = document.getElementById('show-more-btn');
        const count = document.getElementById('remaining-count');
        if (count) count.textContent = remaining;
        if (remaining === 0 && btn) btn.style.display = 'none';
        refreshLayout();
    }

    // ── Show More Blog
    function showMoreBlog() {
        const cards = document.querySelectorAll('.blog-card.hidden');
        Array.from(cards).slice(0, 9).forEach(c => c.classList.remove('hidden'));
        const remaining = document.querySelectorAll('.blog-card.hidden').length;
        const btn = document.getElementById('show-more-blog-btn');
        const count = document.getElementById('remaining-blog-count');
        if (count) count.textContent = remaining;
        if (remaining === 0 && btn) btn.style.display = 'none';
        refreshLayout();
    }

    // ── Show More Achievements
    function showMoreAchievements() {
        const cards = document.querySelectorAll('.achievement-card.hidden');
        Array.from(cards).slice(0, 9).forEach(c => c.classList.remove('hidden'));
        const remaining = document.querySelectorAll('.achievement-card.hidden').length;
        const btn = document.getElementById('show-more-ach-btn');
        const count = document.getElementById('remaining-ach-count');
        if (count) count.textContent = remaining;
        if (remaining === 0 && btn) btn.style.display = 'none';
        refreshLayout();
    }

    // ── Show More Designs
    function showMoreDesigns() {
        const cards = document.querySelectorAll('.design-card.hidden');
        Array.from(cards).slice(0, 9).forEach(c => c.classList.remove('hidden'));
        const remaining = document.querySelectorAll('.design-card.hidden').length;
        const btn = document.getElementById('show-more-designs-btn');
        const count = document.getElementById('remaining-designs-count');
        if (count) count.textContent = remaining;
        if (remaining === 0 && btn) btn.style.display = 'none';
        refreshLayout();
    }

    // ── Gallery Functions
    window.currentImageIndices = {};
    window.setImage = (modalId, imgSrc, index, total) => {
        const mainImg = document.querySelector(`#${modalId}-main-img`);
        const counter = document.querySelector(`#${modalId}-counter`);
        if (mainImg) { mainImg.style.opacity = '0.5'; setTimeout(() => { mainImg.src = imgSrc; mainImg.style.opacity = '1'; }, 150); }
        if (counter) counter.textContent = index + 1;
        window.currentImageIndices[modalId] = index;
        document.querySelectorAll(`#${modalId} button.w-16`).forEach((b, i) => {
            b.classList.toggle('border-neo-yellow', i === index);
            b.classList.toggle('border-white/20', i !== index);
        });
    };
    window.nextImage = (modalId, images) => { let i = (window.currentImageIndices[modalId] || 0); window.setImage(modalId, images[(i+1)%images.length], (i+1)%images.length, images.length); };
    window.prevImage = (modalId, images) => { let i = (window.currentImageIndices[modalId] || 0); window.setImage(modalId, images[(i-1+images.length)%images.length], (i-1+images.length)%images.length, images.length); };

    // ── Hash-based tab switching: intercept clicks on #achievements / #blog links
    // Using click interception instead of hashchange — more reliable with Astro routing
    function activateTabFromHash(hash) {
        if (hash === '#achievements' || hash.endsWith('#achievements')) {
            switchTab('achievements');
            document.getElementById('works')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
            return true;
        }
        if (hash === '#blog' || hash.endsWith('#blog')) {
            switchTab('blog');
            document.getElementById('works')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
            return true;
        }
        if (hash === '#designs' || hash.endsWith('#designs')) {
            switchTab('designs');
            document.getElementById('works')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
            return true;
        }
        if (hash === '#works' || hash.endsWith('#works')) {
            switchTab('projects');
            document.getElementById('works')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
            return true;
        }
        return false;
    }

    // Intercept every click on any anchor that points to #achievements, #blog, #designs, or #works
    document.addEventListener('click', function(e) {
        const link = e.target.closest('a[href]');
        if (!link) return;
        const href = link.getAttribute('href') || '';
        const hashPart = href.includes('#') ? '#' + href.split('#')[1] : '';
        if (hashPart === '#achievements' || hashPart === '#blog' || hashPart === '#designs' || hashPart === '#works') {
            e.preventDefault();
            activateTabFromHash(hashPart);
            history.pushState(null, '', href);
        }
    });

    // Also handle on page load (direct URL with hash, or after refresh)
    (function() {
        const hash = window.location.hash;
        if (hash) {
            // Small delay to ensure DOM is ready
            setTimeout(() => activateTabFromHash(hash), 100);
        }
    })();

</script>
