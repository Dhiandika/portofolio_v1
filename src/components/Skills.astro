---
import { getCollection, getEntry } from 'astro:content';

const skillsCollection = await getCollection('skills');
let skills = skillsCollection;

const siteConfig = await getEntry('site', 'config');

// Fetch Radar Data
const radarEntry = await getEntry("radar", "data");
const radarData = radarEntry?.data.categories || [];

const githubUsername = siteConfig?.data.mediumUsername || 'kpintech'; // Fallback or use a specific field if available. Wait, mediumUsername? 
// Let's check site config again. 'github' is a URL. I need to extract username.
const githubUrl = siteConfig?.data.github || '';
const githubUser = githubUrl.split('/').pop() || 'kpintech';

// GitHub Fetch Logic (Build-time)
let githubLanguages = [];
try {
    const response = await fetch(`https://api.github.com/users/${githubUser}/repos?per_page=100&type=owner`);
    if (response.ok) {
        const repos = await response.json();
        const languageCounts = {};
        let total = 0;

        repos.forEach(repo => {
            if (repo.language && !repo.fork) {
                languageCounts[repo.language] = (languageCounts[repo.language] || 0) + 1;
                total++;
            }
        });

        const langColors = {
            'JavaScript': '#F7DF1E',
            'TypeScript': '#3178C6',
            'Python': '#3776AB',
            'HTML': '#E34F26',
            'CSS': '#1572B6',
            'Vue': '#4FC08D',
            'Svelte': '#FF3E00',
            'Astro': '#FF5D01',
            'Rust': '#000000',
            'Go': '#00ADD8'
        };

        githubLanguages = Object.entries(languageCounts)
            .map(([lang, count]) => ({
                language: lang,
                percentage: Math.round((count as number / total) * 100),
                color: langColors[lang] || '#888888'
            }))
            .sort((a, b) => b.percentage - a.percentage)
            .slice(0, 7); // Top 7
    }
} catch (e) {
    console.error("Failed to fetch GitHub data:", e);
    // Fallback data
    githubLanguages = [
        { language: 'TypeScript', percentage: 40, color: '#3178C6' },
        { language: 'JavaScript', percentage: 30, color: '#F7DF1E' },
        { language: 'Python', percentage: 15, color: '#3776AB' },
        { language: 'Other', percentage: 15, color: '#888888' }
    ];
}

const radarDetails = radarEntry?.data.details || "";

import SkillAnalysis from "./SkillAnalysis.tsx";

/*
// FORCE LOAD all files if collection seems truncated (suspiciously ending at 10)
if (skills.length <= 10) {
    const allSkills = import.meta.glob('/src/content/skills/*.json', { eager: true });
    // ...
}
*/
console.log(`[Skills.astro] Loaded ${skills.length} skills.`);

// Helper to map color names to strict Tailwind classes if dynamic string fails (though we fixed it with safelist)
const colorMap = {
    'neo-yellow': 'hover:bg-neo-yellow',
    'neo-pink': 'hover:bg-neo-pink',
    'neo-blue': 'hover:bg-neo-blue',
    'neo-green': 'hover:bg-neo-green',
    'neo-purple': 'hover:bg-neo-purple',
    'neo-orange': 'hover:bg-neo-orange',
    'white': 'hover:bg-white',
};
---

<section id="skills" class="py-20 bg-neo-black text-neo-white border-y-4 border-black relative">
    <div class="absolute inset-0 opacity-20" style="background-image: linear-gradient(#333 1px, transparent 1px), linear-gradient(90deg, #333 1px, transparent 1px); background-size: 40px 40px;"></div>

    <div class="max-w-[1400px] mx-auto px-4 relative z-10">
        <div class="flex flex-col md:flex-row justify-between items-end mb-12 border-b-4 border-white pb-4">
            <h2 class="text-6xl md:text-8xl font-black uppercase text-white tracking-tighter">
                TECH<span class="text-neo-green">_STACK</span>
            </h2>
            <div class="flex items-center gap-2 mb-2 md:mb-4">
                <div class="w-3 h-3 bg-red-500 rounded-full animate-pulse"></div>
                <p class="font-mono text-neo-green text-sm font-bold">/// SYSTEM_OPTIMIZED</p>
            </div>
        </div>

        <div class="flex flex-col lg:flex-row gap-8">
            <!-- Skills Grid -->
            <div class="flex-1 flex flex-wrap justify-center md:justify-start content-start">
            {
                skills.map((skill) => {
                    const hoverClass = colorMap[skill.data.color || 'white'];
                    
                    return (
                        <div class={`group w-1/2 sm:w-1/3 md:w-1/4 lg:w-1/4 xl:w-1/5 h-24 border-r-2 border-b-2 border-white/20 bg-neo-black ${hoverClass} transition-all duration-0 hover:z-10 relative cursor-hover flex flex-col items-center justify-center p-2`}>
                            <div class="text-neo-green group-hover:text-black font-mono text-xs mb-1 opacity-50">>_ {skill.data.category.toUpperCase()}</div>
                            <div class="text-white group-hover:text-black font-black font-display text-xl uppercase">{skill.data.name}</div>
                        </div>
                    );
                })
            }
            </div>

            <!-- Analysis Widget -->
            <div class="w-full lg:w-1/3">
                <SkillAnalysis 
                    client:visible 
                    radarData={radarData} 
                    githubData={githubLanguages}
                    details={radarDetails}
                />
            </div>
        </div>

        <div class="border-t-4 border-white mt-8 pt-4 flex flex-col font-mono text-xs text-gray-500">
            <div class="flex justify-between w-full">
                <span>TOTAL_NODES: {skills.length}</span>
                <span>MEMORY_USAGE: 128MB</span>
            </div>
            {/* DEBUG: List all loaded skills to identify missing ones */}
            <div class="mt-2 text-[10px] text-neo-green opacity-70 break-all">
                DEBUG_LOADED: {skills.map(s => s.data.name).sort().join(', ')}
            </div>
        </div>
    </div>
</section>
