---
import { getCollection } from "astro:content";

interface Props {
    lang?: string;
}

const { lang = "en" } = Astro.props;

const reviews = await getCollection("reviews");

const ui = {
    en: {
        title: "TRUST PROTOCOLS",
        subtitle: "VERIFIED ENCRYPTED TRANSMISSIONS",
        classification: "TOP SECRET // EYES ONLY",
        verified: "VERIFIED",
    },
    id: {
        title: "PROTOKOL KEPERCAYAAN",
        subtitle: "TRANSMISI TERENKRIPSI TERVERIFIKASI",
        classification: "SANGAT RAHASIA // HANYA UNTUK DIBACA",
        verified: "TERVERIFIKASI",
    },
};

const t = ui[lang as keyof typeof ui] || ui.en;
---

<section id="testimonials" class="py-24 bg-neo-black border-t-4 border-black relative overflow-hidden">
    <!-- Grid Background -->
    <div class="absolute inset-0 opacity-10 pointer-events-none" style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 40px 40px;"></div>

    <div class="max-w-[1400px] mx-auto px-4 relative z-10 mb-16">
        <div data-aos="fade-up" class="flex flex-col md:flex-row justify-between items-end border-b-4 border-white pb-6">
            <div>
                 <div class="bg-neo-blue text-black font-mono font-bold text-xs px-2 py-1 inline-block mb-4 transform -rotate-1">
                    /// VERIFIED_TRANSMISSIONS
                </div>
                <h2 class="text-6xl md:text-8xl font-black uppercase text-white tracking-tighter leading-none">
                    CLIENT<span class="text-neo-yellow">_SAY</span>
                </h2>
            </div>
            <div class="flex gap-4 mt-6 md:mt-0">
                 <div class="text-right hidden md:block">
                    <div class="font-mono text-xs text-gray-400">STATUS</div>
                    <div class="font-mono text-neo-green font-bold animate-pulse">● LIVE_FEED</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scroll Container -->
    <div class="marquee-container relative z-10">
        <div class="testimonials-track flex gap-8 px-4 w-max">
            {
                // Triple config for seamless loop
                [...reviews, ...reviews, ...reviews].map((review, i) => {
                     const isEven = i % 2 === 0;
                     return (
                        <div class={`w-[400px] md:w-[500px] flex-shrink-0 bg-white border-4 border-black p-8 shadow-hard relative group hover:-translate-y-2 transition-transform duration-300`}>
                            <!-- Decor -->
                            <div class={`absolute top-0 left-0 w-full h-2 ${isEven ? 'bg-neo-blue' : 'bg-neo-pink'}`}></div>
                            
                            <div class="flex justify-between items-start mb-6">
                                <div class="flex items-center gap-3">
                                     <div class="w-10 h-10 bg-black text-white flex items-center justify-center border-2 border-transparent">
                                        <i class="ri-user-fill"></i>
                                    </div>
                                    <div>
                                        <h4 class="font-bold uppercase text-lg leading-none">{review.data.author}</h4>
                                        <div class="font-mono text-xs text-gray-500">{lang === 'id' ? review.data.role_id || review.data.role : review.data.role}</div>
                                    </div>
                                </div>
                                <i class="ri-double-quotes-r text-4xl text-gray-200"></i>
                            </div>

                            <p class="font-mono text-sm md:text-base font-bold leading-relaxed mb-6 min-h-[80px]">
                                "{lang === 'id' ? review.data.quote_id || review.data.quote : review.data.quote}"
                            </p>

                            <div class="flex justify-between items-center border-t-2 border-black/10 pt-4">
                                <div class="flex gap-1">
                                    {Array.from({ length: review.data.rating }).map((_) => (
                                        <i class="ri-star-fill text-neo-yellow text-stroke text-sm"></i>
                                    ))}
                                </div>
                                <div class="font-mono text-[10px] text-gray-400 uppercase">
                                    ID: {Math.random().toString(36).substr(2, 6).toUpperCase()}
                                </div>
                            </div>
                        </div>
                     )
                })
            }
        </div>
    </div>
</section>

<style>
    .testimonials-track {
        animation: scroll 40s linear infinite;
    }
    .marquee-container:hover .testimonials-track {
        animation-play-state: paused;
    }
    @keyframes scroll {
        0% { transform: translateX(0); }
        100% { transform: translateX(-33.33%); }
    }
</style>
