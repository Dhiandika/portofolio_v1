---
interface Props {
    lang?: string;
}

const { lang = "en" } = Astro.props;

const ui = {
    en: { settings: "SETTINGS", theme: "THEME", lang: "LANGUAGE" },
    id: { settings: "PENGATURAN", theme: "TEMA", lang: "BAHASA" },
};

const t = ui[lang as keyof typeof ui] || ui.en;
---

<div class="fixed bottom-4 right-4 z-50 flex flex-col gap-4 items-end">
    <!-- Scroll To Top Button -->
    <button
        id="scroll-to-top"
        class="bg-neo-black text-white w-12 h-12 border-2 border-white flex items-center justify-center shadow-hard hover:bg-neo-green hover:text-black hover:shadow-none hover:translate-x-1 hover:translate-y-1 transition-all opacity-0 pointer-events-none translate-y-4 duration-300"
        title="Scroll to Top"
    >
        <i class="ri-arrow-up-line text-xl font-bold"></i>
    </button>

    <div class="relative">
        <button
            id="settings-toggle"
            class="bg-black text-white w-12 h-12 border-2 border-white flex items-center justify-center shadow-hard hover:bg-neo-yellow hover:text-black hover:shadow-none hover:translate-x-1 hover:translate-y-1 transition-all"
        >
            <i class="ri-settings-4-fill text-xl"></i>
        </button>

        <div
            id="settings-panel"
            class="absolute bottom-16 right-0 bg-white border-4 border-black p-4 w-64 shadow-hard-xl hidden origin-bottom-right transition-all"
        >
        <div
            class="flex justify-between items-center mb-4 border-b-2 border-black pb-2"
        >
            <h3 class="font-black text-xl uppercase">{t.settings}</h3>
            <button id="close-settings" class="hover:text-neo-red"
                ><i class="ri-close-line text-2xl"></i></button
            >
        </div>

        <div class="mb-6">
            <h4
                class="font-mono font-bold text-xs mb-2 bg-neo-black text-white px-1 inline-block"
            >
                {t.lang}
            </h4>
            <div class="grid grid-cols-2 gap-2">
                <a
                    href="/en"
                    class={`text-center font-bold border-2 border-black py-1 hover:bg-neo-yellow ${lang === "en" ? "bg-neo-yellow" : "bg-white"}`}
                    >EN</a
                >
                <a
                    href="/id"
                    class={`text-center font-bold border-2 border-black py-1 hover:bg-neo-yellow ${lang === "id" ? "bg-neo-yellow" : "bg-white"}`}
                    >ID</a
                >
            </div>
        </div>

        <div>
            <h4
                class="font-mono font-bold text-xs mb-2 bg-neo-black text-white px-1 inline-block"
            >
                {t.theme}
            </h4>
            <div class="space-y-2">
                <button
                    data-theme="default"
                    class="w-full text-left font-bold border-2 border-black px-2 py-1 hover:bg-neo-yellow theme-btn bg-white uppercase transition-colors"
                    >Default (Neo)</button
                >
                <button
                    data-theme="cyber"
                    class="w-full text-left font-bold border-2 border-black px-2 py-1 hover:bg-neo-blue hover:text-white theme-btn bg-white uppercase transition-colors"
                    >Cyberpunk</button
                >
                <button
                    data-theme="paper"
                    class="w-full text-left font-bold border-2 border-black px-2 py-1 hover:bg-gray-200 theme-btn bg-white uppercase transition-colors text-gray-800"
                    >Paper (Clean)</button
                >
                <button
                    data-theme="lofi"
                    class="w-full text-left font-bold border-2 border-black px-2 py-1 hover:bg-black hover:text-white theme-btn bg-white uppercase transition-colors"
                    >Lo-Fi (Print)</button
                >
            </div>
        </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("astro:page-load", () => {
        const toggle = document.getElementById("settings-toggle");
        const panel = document.getElementById("settings-panel");
        const close = document.getElementById("close-settings");
        const themeBtns = document.querySelectorAll(".theme-btn");

        const html = document.documentElement;

        // UI State
        let isPanelOpen = false;

        function updatePanelState() {
            if (isPanelOpen) {
                panel?.classList.remove("hidden");
            } else {
                panel?.classList.add("hidden");
            }
        }

        // Toggle Panel
        toggle?.addEventListener("click", (e) => {
            e.stopPropagation();
            isPanelOpen = !isPanelOpen;
            updatePanelState();
        });

        close?.addEventListener("click", () => {
            isPanelOpen = false;
            updatePanelState();
        });

        // Close when clicking outside
        document.addEventListener("click", (e) => {
            if (
                isPanelOpen &&
                panel &&
                !panel.contains(e.target as Node) &&
                !toggle?.contains(e.target as Node)
            ) {
                isPanelOpen = false;
                updatePanelState();
            }
        });

        // Theme Logic

        // Initial Theme Load (Force Default/Neo on load as requested)
        const savedTheme = "default"; // Was: localStorage.getItem("theme") || "default";

        // Apply theme
        if (savedTheme === "default") {
            html.removeAttribute("data-theme");
        } else {
            html.setAttribute("data-theme", savedTheme);
        }

        // We still save to local storage for session consistency if they change it later
        localStorage.setItem("theme", savedTheme);

        // Sync Buttons
        themeBtns.forEach((btn) => {
            // Reset
            btn.classList.remove("bg-neo-yellow", "text-black");

            const btnTheme = btn.getAttribute("data-theme");
            if (btnTheme === savedTheme) {
                btn.classList.add("bg-neo-yellow", "text-black");
            }

            // Click Handler
            btn.addEventListener("click", () => {
                const theme = btn.getAttribute("data-theme") || "default";

                if (theme === "default") {
                    html.removeAttribute("data-theme");
                } else {
                    html.setAttribute("data-theme", theme);
                }

                localStorage.setItem("theme", theme);

                // Update Buttons Visuals
                themeBtns.forEach((b) =>
                    b.classList.remove("bg-neo-yellow", "text-black"),
                );
                btn.classList.add("bg-neo-yellow", "text-black");
            });
        });

        // Scroll to Top Logic
        const scrollTopBtn = document.getElementById("scroll-to-top");
        
        window.addEventListener("scroll", () => {
            if (window.scrollY > 300) {
                scrollTopBtn?.classList.remove("opacity-0", "pointer-events-none", "translate-y-4");
            } else {
                scrollTopBtn?.classList.add("opacity-0", "pointer-events-none", "translate-y-4");
            }
        });

        scrollTopBtn?.addEventListener("click", () => {
            if ((window as any).lenis) {
                (window as any).lenis.scrollTo(0);
            } else {
                window.scrollTo({ top: 0, behavior: "smooth" });
            }
        });
    });
</script>
