---
import '../styles/global.css';
import { getEntry } from 'astro:content';
import { ViewTransitions } from 'astro:transitions';
import Loader from '../components/Loader.astro';
import ThemeSettings from '../components/ThemeSettings.astro';
import InteractiveGrid from '../components/InteractiveGrid.astro';
import Spotify from '../components/Spotify.astro';
import Navigation from '../components/Navigation.astro';
import JsonLd from '../components/JsonLd.astro';
import CommandPalette from '../components/CommandPalette.tsx';
import RandomDecorations from '../components/RandomDecorations.astro';
import Soundscapes from '../components/Soundscapes.astro';
import GlitchEffects from '../components/GlitchEffects.astro';
import ContextCursor from '../components/ContextCursor.astro';
import CVDownloadModal from '../components/CVDownloadModal.astro';
import AOSInit from '../components/AOSInit.astro';

interface Props {
	title?: string;
    lang?: string;
    image?: string;
}

const siteConfig = await getEntry('site', 'config');
const { data } = siteConfig || { data: {} as any };
import { getCollection } from 'astro:content';
const projects = await getCollection('projects');
const posts = await getCollection('blog');

const { 
    pageTitle = 'Dhiandika | Full Stack ', 
    pageTitle_id,
    metaDescription = 'A Neo-Brutalist portfolio showcasing full-stack development skills.', 
    metaDescription_id,
    metaKeywords = 'full stack, developer, neo-brutalist, portfolio',
    favicon = '/favicon.svg',
    gtmId
} = data;

const { lang = 'en' } = Astro.props;
const title = Astro.props.title || (lang === 'id' ? pageTitle_id || pageTitle : pageTitle);
const description = lang === 'id' ? metaDescription_id || metaDescription : metaDescription;

const defaultOgUrl = `/api/og?title=${encodeURIComponent(title)}&desc=${encodeURIComponent(description)}&type=PORTFOLIO`;
const image = Astro.props.image || defaultOgUrl;

// === SEO: Canonical & Hreflang ===
// Normalize path: always ensure trailing slash for consistency
const rawPath = Astro.url.pathname;
const normalizedPath = rawPath.endsWith('/') ? rawPath : rawPath + '/';
const siteOrigin = 'https://npemburu.my.id';

// Canonical = current page with normalized trailing slash
const canonicalUrl = `${siteOrigin}${normalizedPath}`;

// Hreflang alternates: swap /en/ ↔ /id/
const enPath = normalizedPath.replace(/^\/(id|en)\//, '/en/');
const idPath = normalizedPath.replace(/^\/(id|en)\//, '/id/');
const hreflangEn = `${siteOrigin}${enPath}`;
const hreflangId = `${siteOrigin}${idPath}`;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={favicon} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

        <!-- Canonical URL (prevents duplicate indexing) -->
        <link rel="canonical" href={canonicalUrl} />

        <!-- Hreflang: Tell search engines about language alternatives -->
        <link rel="alternate" hreflang="en" href={hreflangEn} />
        <link rel="alternate" hreflang="id" href={hreflangId} />
        <link rel="alternate" hreflang="x-default" href={hreflangEn} />

        <!-- Allow indexing -->
        <meta name="robots" content="index, follow" />

        <!-- Meta Tags -->
        <meta name="keywords" content={metaKeywords}>
        <meta name="author" content={data.brandName || "Arham"}>

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={Astro.url} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={new URL(image, Astro.url)} />

        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={Astro.url} />
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={new URL(image, Astro.url)} />
        
        <!-- Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700;800&family=Space+Grotesk:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet" media="print" onload="this.media='all'">
        <noscript><link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet"></noscript>
        {gtmId && (
            <script define:vars={{ gtmId }}>
                console.log('GTM Loaded:', gtmId);
            </script>
        )}
        <JsonLd />
        <ViewTransitions />
	</head>
	<body class="text-neo-black font-display antialiased selection:bg-neo-black selection:text-neo-yellow relative bg-neo-texture">
        <!-- Interactive Background -->
        <InteractiveGrid />
        
        <!-- Random Decorative Elements -->
        <RandomDecorations />

        <!-- Progress Bar -->
        <div class="fixed top-0 left-0 lg:left-12 h-2 bg-neo-green z-[60] border-b-2 border-black" id="progressBar" style="width: 0%"></div>

        <!-- Overlays -->
        <Soundscapes />
        <GlitchEffects />
        <ContextCursor />
        <Loader lang={lang} />
        <CommandPalette client:idle lang={lang} projects={projects} posts={posts} />
        <CVDownloadModal lang={lang} />

        <!-- Main Content Wrapper -->
        <main id="main-content" class="relative z-10 lg:pl-12">
            <Navigation lang={lang} />
            <ThemeSettings lang={lang} />
            <Spotify />
            <slot />
        </main>

        <script>
            import '../scripts/main.js';

            // Matrix Easter Egg Logic
            let keySequence: string[] = [];
            const secretCode = 'matrix';

            document.addEventListener('keydown', (e) => {
                keySequence.push(e.key.toLowerCase());
                if (keySequence.length > secretCode.length) {
                    keySequence.shift();
                }
                if (keySequence.join('') === secretCode) {
                    activateHackerMode();
                    keySequence = [];
                }
            });

            function activateHackerMode() {
                const overlay = document.getElementById('hacker-overlay');
                if (overlay) {
                    overlay.classList.remove('hidden');
                    const audio = new Audio('https://assets.mixkit.co/sfx/preview/mixkit-sci-fi-system-failure-2999.mp3'); 
                    audio.volume = 0.5;
                    audio.play().catch(e => console.log('Audio autoplay blocked'));
                    document.documentElement.setAttribute('data-theme', 'cyber');
                    localStorage.setItem('theme', 'cyber');
                    setTimeout(() => {
                        overlay.classList.add('hidden');
                        window.scrollTo({ top: 0, behavior: 'smooth' });
                    }, 2500);
                }
            }
        </script>

        <!-- Hacker Mode Overlay -->
        <div id="hacker-overlay" class="fixed inset-0 bg-black z-[100] hidden flex flex-col items-center justify-center text-neo-green font-mono select-none pointer-events-none">
            <h1 class="text-4xl md:text-8xl font-black mb-4 animate-pulse">SYSTEM BREACH</h1>
            <p class="text-xl md:text-2xl">> ACCESS GRANTED: CYBERPUNK MODE ACTIVATED</p>
        </div>

        <!-- AOS (Animate on Scroll) via npm -->
        <AOSInit />
	</body>
</html>
