---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 | SYSTEM FAILURE">
    <div class="min-h-screen bg-neo-blue flex flex-col items-center justify-center text-white font-mono p-4 relative overflow-hidden">
        <!-- Background Noise/Glitch Effect (Simplified with CSS) -->
        <div class="absolute inset-0 opacity-10 pointer-events-none" style="background-image: url('/noise.png');"></div>

        <div class="border-4 border-white p-8 md:p-12 max-w-2xl w-full bg-neo-blue shadow-[16px_16px_0_0_rgba(0,0,0,1)] relative z-10 text-center">
            <h1 class="text-9xl font-black mb-4 glitch-hover" data-text="404">404</h1>
            <h2 class="text-3xl md:text-5xl font-bold bg-white text-neo-blue inline-block px-4 py-2 mb-8 transform -rotate-2">
                SYSTEM_FAILURE
            </h2>
            
            <p class="text-xl mb-8 leading-relaxed">
                CRITICAL_ERROR: The requested trajectory does not exist in this dimension.
                The content you are looking for has been [DELETED] or [MOVED].
            </p>
            
            <div class="font-mono text-sm bg-black/20 p-4 text-left mb-8 border-l-4 border-white">
                > ERROR_CODE: PAGE_NOT_FOUND<br>
                > ORIGIN: USER_NAVIGATION<br>
                > ACTION: INITIATING_REBOOT...
            </div>

            <a href="/" class="inline-block bg-white text-neo-blue text-xl font-black px-8 py-4 border-4 border-transparent hover:bg-black hover:text-white hover:border-white transition-all shadow-hard hover:shadow-none">
                RETURN_HOME ( )
            </a>
        </div>

        <div class="absolute bottom-8 text-xs opacity-50">
            Memory Dump: 0x00000000... // END OF LINE
        </div>
    </div>
</Layout>
