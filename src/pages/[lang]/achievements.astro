---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
    return [
        { params: { lang: 'en' } },
        { params: { lang: 'id' } },
    ];
}

const { lang } = Astro.params;
const certificates = await getCollection('certificates');

const ui = {
    en: { title: "Achievements", subtitle: "Certificates & Awards", search: "Search certificates...", all: "All", course: "Course", bootcamp: "Bootcamp", event: "Event", competition: "Competition" },
    id: { title: "Pencapaian", subtitle: "Sertifikat & Penghargaan", search: "Cari sertifikat...", all: "Semua", course: "Kursus", bootcamp: "Bootcamp", event: "Acara", competition: "Kompetisi" },
};

const t = ui[lang as keyof typeof ui] || ui.en;
---

<Layout title={`${t.title} | Arham.exe`} lang={lang}>
    <main class="min-h-screen text-neo-black pt-32 px-4 pb-20 border-t-8 border-black">
        <div class="max-w-7xl mx-auto">
            <!-- Header -->
            <div data-aos="fade-up" class="mb-12">
                <h1 class="text-5xl md:text-7xl font-black uppercase mb-4 tracking-tighter text-neo-black">{t.title}</h1>
                <p class="font-mono text-xl md:text-2xl text-neo-black/70 border-l-4 border-neo-green pl-4">{t.subtitle}</p>
            </div>

            <!-- Controls -->
            <div class="flex flex-col md:flex-row gap-4 mb-12 sticky top-28 z-[90] bg-neo-white py-4 border-b-4 border-black/10">
                <div class="relative flex-grow">
                    <i class="ri-search-line absolute left-4 top-1/2 -translate-y-1/2 text-xl opacity-50 text-black"></i>
                    <input type="text" id="searchInput" placeholder={t.search} class="w-full bg-white text-black border-4 border-black p-4 pl-12 font-mono shadow-[6px_6px_0_0_#000] focus:outline-none focus:shadow-none focus:translate-x-1 focus:translate-y-1 transition-all" />
                </div>
                <div class="flex gap-2 overflow-x-auto pb-2 md:pb-0 scrollbar-hide">
                    <button class="filter-btn active bg-black text-white px-6 py-4 border-4 border-black font-black uppercase shadow-[6px_6px_0_0_#000] hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all flex-shrink-0" data-filter="all">{t.all}</button>
                    <button class="filter-btn bg-white text-black px-6 py-4 border-4 border-black font-black uppercase shadow-[6px_6px_0_0_#000] hover:bg-neo-yellow hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all flex-shrink-0" data-filter="Course">{t.course}</button>
                    <button class="filter-btn bg-white text-black px-6 py-4 border-4 border-black font-black uppercase shadow-[6px_6px_0_0_#000] hover:bg-neo-blue hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all flex-shrink-0" data-filter="Bootcamp">{t.bootcamp}</button>
                    <button class="filter-btn bg-white text-black px-6 py-4 border-4 border-black font-black uppercase shadow-[6px_6px_0_0_#000] hover:bg-neo-pink hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all flex-shrink-0" data-filter="Event">{t.event}</button>
                </div>
            </div>

            <!-- Grid -->
            <div id="certGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {certificates.map((cert, index) => {
                    const title = lang === 'id' ? cert.data.title_id || cert.data.title : cert.data.title;
                    const desc = (lang === 'id' ? cert.data.description_id || cert.data.description : cert.data.description) || "";
                    const achCategoryIcons: any = { "Course": "ri-book-read-line", "Bootcamp": "ri-terminal-box-line", "Event": "ri-calendar-event-line", "Competition": "ri-medal-line" };
                    const catIcon = achCategoryIcons[cert.data.category || "Course"] || "ri-award-line";
                    const skills = cert.data.skills_verified || [];
                    
                    return (
                    <>
                        <article data-aos="fade-up" data-aos-delay={String((index % 3) * 80)} class="cert-card group border-4 border-black bg-white shadow-[6px_6px_0_0_#000] hover:shadow-[10px_10px_0_0_#3BFF7E] hover:border-neo-green transition-all duration-300 flex flex-col overflow-hidden h-full" data-category={cert.data.category} data-title={title.toLowerCase()} data-issuer={cert.data.issuer.toLowerCase()} data-desc={desc.toLowerCase()}>
                            {cert.data.image && (
                                <div class="relative h-48 overflow-hidden border-b-4 border-black group-hover:border-neo-green transition-colors">
                                    <img src={cert.data.image} alt={title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" onerror="this.onerror=null;this.style.opacity='0';" />
                                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
                                    <button 
                                        class="category-badge absolute top-3 left-3 flex items-center gap-1 bg-neo-green text-black text-[10px] font-black px-2 py-1 uppercase tracking-widest border-2 border-black z-10 hover:bg-white transition-colors"
                                        onclick={`event.preventDefault(); event.stopPropagation(); filterByCategory('${cert.data.category}')`}
                                    >
                                        <i class={catIcon + " text-xs"}></i> {cert.data.category || 'Course'}
                                    </button>
                                </div>
                            )}
                            <div class="flex flex-col flex-1 p-5">
                                <div class="font-mono text-[10px] text-neo-black/60 mb-2 uppercase">{cert.data.date} · {cert.data.issuer}</div>
                                <h3 class="text-base font-black text-neo-black uppercase leading-tight mb-2 group-hover:text-neo-green transition-colors line-clamp-2">{title}</h3>
                                <p class="font-mono text-neo-black/70 text-[11px] leading-relaxed mb-4 flex-1">{desc}</p>
                                
                                {skills.length > 0 && (
                                    <div class="flex flex-wrap gap-1.5 mb-4">
                                        {skills.slice(0, 4).map((skill: string) => (
                                            <span class="text-[9px] font-mono font-bold border border-black/20 bg-gray-100 text-neo-black/70 px-2 py-0.5">#{skill}</span>
                                        ))}
                                        {skills.length > 4 && (
                                            <span class="text-[9px] font-mono font-bold border border-black/20 bg-gray-100 text-neo-black/70 px-2 py-0.5">+{skills.length - 4}</span>
                                        )}
                                    </div>
                                )}

                                <div class="mt-auto border-t-2 border-black/10 pt-3">
                                    <button class="w-full bg-neo-black text-white border-2 border-black py-2 font-black uppercase text-xs tracking-widest hover:bg-neo-green hover:text-black transition-colors flex items-center justify-center gap-2" onclick={`document.getElementById('modal-${cert.id}').classList.remove('hidden'); document.getElementById('modal-${cert.id}').classList.add('flex'); document.body.style.overflow = 'hidden';`}>
                                        <i class="ri-eye-line"></i> View Detail
                                    </button>
                                </div>
                            </div>
                        </article>

                        {/* Modal Overlay */}
                        <div id={`modal-${cert.id}`} class="fixed inset-0 p-4 md:p-8 bg-white/90 z-[99000] hidden items-center justify-center animate-fade-in backdrop-blur-sm" onclick={`if(event.target === this) { this.classList.remove('flex'); this.classList.add('hidden'); document.body.style.overflow = ''; }`}>
                            <div class="bg-white border-4 border-black shadow-[15px_15px_0_0_#000] flex flex-col md:flex-row max-h-[90vh] w-full max-w-5xl relative overflow-hidden" onclick="event.stopPropagation()">
                                <button class="absolute top-4 right-4 z-50 bg-red-500 text-white w-10 h-10 border-2 border-black hover:bg-black hover:text-red-500 transition-colors shadow-[4px_4px_0_0_#000] flex items-center justify-center" onclick={`document.getElementById('modal-${cert.id}').classList.remove('flex'); document.getElementById('modal-${cert.id}').classList.add('hidden'); document.body.style.overflow = '';`}>
                                    <i class="ri-close-line text-xl font-bold"></i>
                                </button>
                                
                                <!-- Image Section -->
                                <div class="md:w-3/5 bg-gray-100 border-r-4 border-black p-6 md:p-8 flex items-center justify-center relative overflow-hidden min-h-[300px]">
                                     {cert.data.image ? (
                                        <img src={cert.data.image} alt={title} class="max-w-full max-h-full object-contain relative z-10 shadow-lg" />
                                    ) : (
                                        <div class="flex flex-col items-center justify-center text-black/30">
                                            <i class="ri-award-line text-8xl mb-4"></i>
                                            <p class="font-mono text-sm">NO IMAGE AVAILABLE</p>
                                        </div>
                                    )}
                                </div>
                                
                                <!-- Info Section -->
                                <div class="md:w-2/5 p-6 md:p-8 flex flex-col bg-white overflow-y-auto">
                                    <div class="mb-6">
                                        <span class="inline-flex items-center gap-1.5 bg-neo-yellow text-black border-2 border-black px-3 py-1 font-black uppercase text-[10px] tracking-widest shadow-[4px_4px_0_0_#000] mb-4">
                                            <i class={catIcon}></i> {cert.data.category}
                                        </span>
                                        <h2 class="text-3xl font-black uppercase leading-none mb-2 text-black">{title}</h2>
                                        <p class="font-mono text-sm text-neo-black/60 mb-6">{cert.data.issuer} • {cert.data.date}</p>
                                    </div>
                                    
                                    {cert.data.credentialId && (
                                        <div class="mb-6 font-mono text-xs bg-gray-100 p-2 border border-black inline-block self-start text-black">
                                            <span class="font-bold text-black">ID:</span> {cert.data.credentialId}
                                        </div>
                                    )}

                                    {desc && (
                                        <div class="mb-8">
                                            <h3 class="font-black text-black uppercase text-sm mb-3 border-b-2 border-black/20 pb-2">Description</h3>
                                            <p class="text-black/80 font-mono text-sm leading-relaxed">{desc}</p>
                                        </div>
                                    )}

                                    {skills.length > 0 && (
                                        <div class="mb-8">
                                            <h3 class="font-black text-black uppercase text-sm mb-3 border-b-2 border-black/20 pb-2">Skills Verified</h3>
                                            <div class="flex flex-wrap gap-2">
                                                {skills.map((skill: any) => (
                                                    <span class="bg-black text-white border border-black px-3 py-1 font-mono text-[10px] uppercase font-bold">{skill}</span>
                                                ))}
                                            </div>
                                        </div>
                                    )}

                                    <div class="mt-auto pt-6 border-t-2 border-black/20">
                                        {cert.data.link ? (
                                            <a href={cert.data.link} target="_blank" class="w-full bg-neo-black text-white border-4 border-black py-3 font-black uppercase tracking-widest hover:bg-neo-green hover:text-black hover:border-neo-green transition-colors flex items-center justify-center gap-2 shadow-[6px_6px_0_0_#000] hover:shadow-none hover:translate-x-1 hover:translate-y-1">
                                                Verify Credential <i class="ri-external-link-line"></i>
                                            </a>
                                        ) : (
                                            <button disabled class="w-full bg-gray-200 text-gray-400 border-4 border-gray-300 py-3 font-black uppercase tracking-widest cursor-not-allowed flex items-center justify-center gap-2">
                                                No External Link
                                            </button>
                                        )}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </>
                    );
                })}
            </div>

            <!-- Empty State -->
            <div id="emptyState" class="hidden flex-col items-center justify-center py-24 text-center">
                 <i class="ri-file-search-line text-6xl mb-4 text-neo-black"></i>
                 <h3 class="text-2xl font-black uppercase">No certificates found</h3>
                 <p class="font-mono">Try adjusting your search or filter.</p>
            </div>
        </div>
    </main>

    <script is:inline>
        const searchInput = document.getElementById('searchInput');
        const filterBtns = document.querySelectorAll('.filter-btn');
        const cards = document.querySelectorAll('.cert-card');
        const emptyState = document.getElementById('emptyState');

        function filter() {
            const query = searchInput.value.toLowerCase();
            const activeCategory = document.querySelector('.filter-btn.active').dataset.filter;
            let visibleCount = 0;

            cards.forEach(card => {
                const title = card.dataset.title || "";
                const issuer = card.dataset.issuer || "";
                const desc = card.dataset.desc || "";
                const category = card.dataset.category;
                
                const matchesSearch = title.includes(query) || issuer.includes(query) || desc.includes(query);
                const matchesCategory = activeCategory === 'all' || category === activeCategory;

                if (matchesSearch && matchesCategory) {
                    card.style.display = 'flex';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            emptyState.style.display = visibleCount === 0 ? 'flex' : 'none';
        }

        searchInput.addEventListener('input', filter);

        filterBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelector('.filter-btn.active').classList.remove('active', 'bg-black', 'text-white');
                document.querySelector('.filter-btn.active').classList.add('bg-white', 'text-black');
                
                btn.classList.add('active', 'bg-black', 'text-white');
                btn.classList.remove('bg-white');
                
                filter();
            });
        });

        // Global function for category clicks (Re-exposed)
        window.filterByCategory = (category) => {
            const btn = document.querySelector(`.filter-btn[data-filter="${category}"]`);
            if (btn) {
                btn.click();
                
                // Force scroll after a short delay to ensure UI updates
                setTimeout(() => {
                     document.getElementById('certGrid').scrollIntoView({ behavior: 'smooth', block: 'start' });
                }, 100);
            }
        };

    </script>
</Layout>
