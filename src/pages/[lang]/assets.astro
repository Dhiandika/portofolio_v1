---
import Layout from "../../layouts/Layout.astro";
import FileManager from "../../components/FileManager.tsx";
import { getCollection, getEntry } from "astro:content";

export async function getStaticPaths() {
    return [{ params: { lang: "en" } }, { params: { lang: "id" } }];
}

const { lang } = Astro.params;
const siteConfig = await getEntry("site", "config");
const assetsCollection = await getCollection("assets");

// Sort by title for now
const assets = assetsCollection
    .map((a) => a.data)
    .sort((a, b) => a.title.localeCompare(b.title));

const t = {
    en: {
        title: "DATA_BANK",
        subtitle: "Access denied... just kidding. Download my assets here.",
    },
    id: {
        title: "BANK_DATA",
        subtitle: "Akses ditolak... bercanda. Unduh aset saya di sini.",
    },
};

const text = t[lang as keyof typeof t] || t.en;
---

<Layout title={`ASSETS | ${siteConfig.data.brandName}`} lang={lang}>
    <main class="pt-32 pb-24 px-4 max-w-5xl mx-auto min-h-screen">
        <header class="mb-12 text-center">
            <h1
                class="text-6xl md:text-8xl font-black uppercase mb-4 tracking-tighter glitched-text"
            >
                {text.title}
            </h1>
            <p
                class="font-mono text-xl bg-neo-blue text-white inline-block px-4 py-2 font-bold border-2 border-black shadow-hard transform rotate-1"
            >
                {text.subtitle}
            </p>
        </header>

        <section>
            <FileManager client:load assets={assets} />
        </section>

        <div class="mt-12 text-center text-xs font-mono text-gray-400">
            <p>SECURE_CONNECTION_ESTABLISHED</p>
            <p>IP_LOGGED: 127.0.0.1</p>
        </div>

        <div class="mt-12 text-center">
            <a
                href={`/${lang}`}
                class="inline-block font-mono font-bold text-gray-500 hover:text-black border-b-2 border-transparent hover:border-black transition-all"
            >
                &larr; RETURN_HOME
            </a>
        </div>
    </main>
</Layout>
