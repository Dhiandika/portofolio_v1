---
import Layout from "../../../layouts/Layout.astro";
import TableOfContents from "../../../components/TableOfContents.astro";
import ClapButton from "../../../components/ClapButton.astro";
import { getCollection } from "astro:content";
import { getEntry } from "astro:content";
import { Image } from "astro:assets";

const blogSlugImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/**/*.{jpeg,jpg,png,gif,webp}');

const { lang, slug } = Astro.params;

if (!slug) {
    return Astro.redirect("/404");
}

const posts = await getCollection("blog");
const post = posts.find((p: any) => p.slug === slug);

if (!post) {
    return Astro.redirect("/404");
}

const siteConfig = await getEntry("site", "config");
const { data: siteData } = siteConfig || { data: { brandName: "ARHAM" } };

const { Content, headings } = await post.render();

const ui = {
    en: { back: "RETURN_TO_LOG", published: "PUBLISHED_ON" },
    id: { back: "KEMBALI_KE_LOG", published: "DITERBITKAN_PADA" },
};

const t = ui[lang as keyof typeof ui] || ui.en;
const title =
    lang === "id" ? post.data.title_id || post.data.title : post.data.title;

const coverPromise = post.data.coverImage ? blogSlugImages[post.data.coverImage] : null;
const optimizedCover = coverPromise ? await coverPromise() : null;
---

<Layout
    title={`${title} | ${siteData.brandName || "Npemburu"}`}
    lang={lang}
    image={`/og/${post.slug}.png`}
>
    <main
        class="min-h-screen pt-32 pb-20 px-4 md:px-8 bg-neo-white bg-neo-texture"
    >
        <div
            class="zen-controls fixed bottom-8 right-8 z-50 flex flex-col gap-4"
        >
            <button
                id="zenToggle"
                class="bg-neo-black text-white p-4 shadow-hard hover:bg-neo-green hover:text-black transition-colors rounded-full border-2 border-neo-white"
                title="Toggle Zen Mode"
            >
                <i class="ri-eye-line text-xl"></i>
            </button>
            <button
                id="scrollTop"
                class="bg-white text-neo-black p-4 shadow-hard hover:bg-neo-black hover:text-white transition-colors rounded-full border-2 border-neo-black hidden"
                title="Scroll to Top"
            >
                <i class="ri-arrow-up-line text-xl"></i>
            </button>
        </div>

        <div
            class="grid grid-cols-1 lg:grid-cols-[1fr_250px] gap-8 max-w-6xl mx-auto relative"
        >
            <article class="max-w-3xl w-full">
                {/* Navigation */}
                <div class="zen-hidden">
                    <a
                        href={`/${lang}/blog`}
                        class="inline-flex items-center gap-2 font-mono font-bold hover:-translate-x-1 transition-transform mb-8 bg-white border-2 border-neo-black px-4 py-2 shadow-hard hover:shadow-none text-sm uppercase tracking-wider"
                    >
                        <i class="ri-arrow-left-line"></i>
                        {t.back}
                    </a>
                </div>

                {/* Header Section */}
                <header
                    data-aos="fade-up"
                    class="mb-12 bg-white border-4 border-neo-black p-6 md:p-10 shadow-hard relative overflow-hidden group"
                >
                    {/* Decorative Background Element */}
                    <div
                        class="absolute -top-10 -right-10 w-40 h-40 bg-neo-yellow rounded-full blur-3xl opacity-20 group-hover:opacity-40 transition-opacity"
                    >
                    </div>

                    <div class="relative z-10">
                        <div class="flex flex-wrap items-center gap-4 mb-6">
                            <span
                                class="font-mono text-xs font-black bg-neo-black text-white px-3 py-1"
                            >
                                {
                                    new Date(
                                        post.data.publishedDate,
                                    ).toLocaleDateString(
                                        lang === "id" ? "id-ID" : "en-US",
                                        {
                                            year: "numeric",
                                            month: "long",
                                            day: "numeric",
                                        },
                                    )
                                }
                            </span>
                            <span
                                id="view-count"
                                class="font-mono text-xs font-black bg-neo-yellow text-neo-black px-3 py-1 opacity-0 transition-opacity duration-300 border-2 border-neo-black shadow-[2px_2px_0px_#000]"
                            >
                                ... VIEWS
                            </span>
                            {
                                post.data.topics && (
                                    <div class="flex flex-wrap gap-2">
                                        {post.data.topics.map(
                                            (topic: string) => (
                                                <span class="font-mono text-xs font-bold border border-neo-black px-2 py-1 bg-gray-100 text-gray-600 uppercase">
                                                    #{topic}
                                                </span>
                                            ),
                                        )}
                                    </div>
                                )
                            }
                        </div>

                        <h1
                            class="text-4xl md:text-5xl lg:text-6xl font-black mb-6 leading-[1.1] uppercase tracking-tight"
                        >
                            {title}
                        </h1>

                        {
                            post.data.subtitle && (
                                <p class="text-xl md:text-2xl font-mono text-gray-600 leading-relaxed border-l-4 border-neo-purple pl-6 italic">
                                    {post.data.subtitle}
                                </p>
                            )
                        }
                    </div>
                </header>

                {/* Featured Image */}
                {
                    post.data.coverImage && (
                        <div data-aos="fade-up" data-aos-delay="100" class="mb-12 border-4 border-neo-black shadow-hard overflow-hidden relative group">
                            <div class="aspect-video relative">
                                <div class="absolute inset-0 bg-neo-purple/10 group-hover:bg-transparent transition-colors z-10 pointer-events-none" />
                                {optimizedCover ? (
                                    <Image
                                        src={optimizedCover.default}
                                        alt={title}
                                        width={1200}
                                        height={675}
                                        format="webp"
                                        class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700"
                                    />
                                ) : (
                                    <div class="w-full h-full flex items-center justify-center bg-gray-200">
                                        <i class="ri-image-line text-6xl text-gray-400"></i>
                                    </div>
                                )}
                            </div>
                            {post.data.canonicalUrl && (
                                <a
                                    href={post.data.canonicalUrl}
                                    target="_blank"
                                    class="absolute bottom-0 right-0 bg-black text-white px-6 py-3 font-mono font-bold hover:bg-neo-green hover:text-black transition-colors flex items-center gap-2 z-20 border-t-4 border-l-4 border-neo-black"
                                >
                                    <i class="ri-medium-fill text-xl" /> READ ON
                                    MEDIUM
                                </a>
                            )}
                        </div>
                    )
                }

                {/* Content Body */}
                <div
                    data-aos="fade-up"
                    data-aos-delay="150"
                    class="prose prose-lg md:prose-xl max-w-none
                    prose-headings:font-black prose-headings:font-display prose-headings:uppercase prose-headings:tracking-tight
                    prose-p:font-serif prose-p:text-neo-black/90 prose-p:leading-loose
                    prose-a:text-neo-blue prose-a:font-bold prose-a:no-underline hover:prose-a:underline hover:prose-a:decoration-4 hover:prose-a:decoration-neo-yellow
                    prose-img:border-4 prose-img:border-neo-black prose-img:shadow-hard prose-img:my-8
                    prose-blockquote:border-l-8 prose-blockquote:border-neo-black prose-blockquote:bg-gray-100 prose-blockquote:py-4 prose-blockquote:px-6 prose-blockquote:not-italic prose-blockquote:font-mono
                    prose-code:bg-black prose-code:text-neo-green prose-code:px-2 prose-code:py-1 prose-code:rounded-none prose-code:font-mono prose-code:font-bold
                    prose-pre:bg-neo-black prose-pre:border-4 prose-pre:border-black prose-pre:shadow-hard
                    prose-li:marker:text-neo-purple
                    bg-white p-6 md:p-12 border-4 border-neo-black shadow-hard"
                >
                    <Content />
                </div>

                {/* Footer / Signature */}
                <hr class="border-t-4 border-neo-black my-12" />
                <div
                    class="flex justify-between items-center font-mono opacity-60 hover:opacity-100 transition-opacity"
                >
                    <span>END OF TRANSMISSION</span>
                    <ClapButton />
                    <span class="text-2xl">⚡</span>
                </div>
            </article>

            <aside class="hidden lg:block h-full zen-hidden">
                <TableOfContents headings={headings} />
            </aside>
        </div>

        <script>
            const zenToggle = document.getElementById("zenToggle");
            const scrollTop = document.getElementById("scrollTop");

            // Zen Mode Logic
            zenToggle?.addEventListener("click", () => {
                document.body.classList.toggle("zen-mode");
                const isZen = document.body.classList.contains("zen-mode");

                // Update Icon
                const icon = zenToggle.querySelector("i");
                if (icon) {
                    icon.className = isZen
                        ? "ri-eye-off-line text-xl"
                        : "ri-eye-line text-xl";
                }
            });

            // Scroll Top Logic
            window.addEventListener("scroll", () => {
                if (window.scrollY > 500) {
                    scrollTop?.classList.remove("hidden");
                } else {
                    scrollTop?.classList.add("hidden");
                }
            });

            scrollTop?.addEventListener("click", () => {
                window.scrollTo({ top: 0, behavior: "smooth" });
            });

            // View Counter Logic
            document.addEventListener("astro:page-load", () => {
                const viewCountEl = document.getElementById("view-count");
                if (viewCountEl) {
                    const pathname = window.location.pathname;
                    if (pathname.includes("/blog/")) {
                        // strip trailing slash for cleaner split
                        const slug = pathname
                            .replace(/\/$/, "")
                            .split("/")
                            .pop();
                        if (slug) {
                            fetch(`/api/views/${slug}`, { method: "POST" })
                                .then((res) => res.json())
                                .then((data) => {
                                    if (data.views !== undefined) {
                                        viewCountEl.textContent = `${data.views} VIEWS`;
                                        viewCountEl.classList.remove(
                                            "opacity-0",
                                        );
                                        viewCountEl.classList.add(
                                            "opacity-100",
                                        );
                                    }
                                })
                                .catch((err) =>
                                    console.error(
                                        "Failed to update views",
                                        err,
                                    ),
                                );
                        }
                    }
                }
            });
        </script>
    </main>
</Layout>
