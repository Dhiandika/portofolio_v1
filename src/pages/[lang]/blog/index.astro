---
import Layout from "../../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { getEntry } from "astro:content";
import { getMediumPosts } from "../../../utils/medium";

export async function getStaticPaths() {
    return [{ params: { lang: "en" } }, { params: { lang: "id" } }];
}

const { lang } = Astro.params;
const localPosts = await getCollection("blog");
const siteConfig = await getEntry("site", "config");
const { data: siteData } = siteConfig || {
    data: {
        brandName: "ARHAM",
        pageTitle: "ARHAM",
        mediumUsername: "dhiandika",
    },
};

// Format Local
const formattedLocalPosts = localPosts.map((post) => ({
    title:
        lang === "id" ? post.data.title_id || post.data.title : post.data.title,
    date: new Date(post.data.publishedDate),
    coverImage: post.data.coverImage,
    excerpt:
        lang === "id"
            ? post.data.excerpt_id || post.data.excerpt
            : post.data.excerpt,
    slug: post.slug,
    link: `/${lang}/blog/${post.slug}`,
    isExternal: false,
    topics: post.data.topics || [],
}));

// Fetch & Format Medium
const mediumPostsRaw = await getMediumPosts(
    siteData.mediumUsername || "dhiandika",
);
const formattedMediumPosts = mediumPostsRaw.map((post) => ({
    title: post.title,
    date: new Date(post.pubDate),
    coverImage: post.thumbnail,
    excerpt: post.description,
    slug: post.link, // Use link as slug for unique key if needed
    link: post.link,
    isExternal: true,
    topics: post.categories || [],
}));

const allPosts = [...formattedLocalPosts, ...formattedMediumPosts].sort(
    (a, b) => b.date.valueOf() - a.date.valueOf(),
);

const ui = {
    en: {
        title: "TRANSMISSION_LOG",
        subtitle: "Thoughts, rants, and code snippets from the void.",
        readMore: "READ_DATA",
        search: "Search logs...",
    },
    id: {
        title: "CATATAN_TRANSMISI",
        subtitle: "Pemikiran, keluhan, dan potongan kode dari kehampaan.",
        readMore: "BACA_DATA",
        search: "Cari transmisi...",
    },
};

// Extract all unique topics
const allTopics = [...new Set(allPosts.flatMap((post) => post.topics))].sort();

const t = ui[lang as keyof typeof ui] || ui.en;
---

<Layout title={`${t.title} | ${siteData.brandName || "ARHAM"}`} lang={lang}>
    <main class="pt-32 pb-20 px-4 md:px-8 max-w-7xl mx-auto">
        <header class="mb-12">
            <h1
                class="text-6xl md:text-8xl font-black mb-4 glitch-hover"
                data-text={t.title}
            >
                {t.title}
            </h1>
            <p
                class="text-xl md:text-2xl font-mono text-neo-black/70 border-l-4 border-neo-black pl-4"
            >
                {t.subtitle}
            </p>
        </header>

        {/* Search & Filter Bar */}
        <div
            class="mb-8 z-30 bg-[#f0f0f0] py-2 border-b-2 border-black/10 -mx-4 px-4 md:mx-0 md:px-0 flex flex-col gap-3"
        >
            <div class="relative w-full">
                <i
                    class="ri-search-line absolute left-3 top-1/2 -translate-y-1/2 text-lg opacity-50"
                ></i>
                <input
                    type="text"
                    id="searchInput"
                    placeholder={t.search}
                    class="w-full bg-white border-2 border-neo-black p-2 pl-10 font-mono shadow-hard focus:outline-none focus:shadow-none focus:translate-x-1 focus:translate-y-1 transition-all text-sm"
                />
            </div>

            <div class="flex gap-2 overflow-x-auto pb-2 scrollbar-hide">
                <button
                    class="filter-btn active bg-neo-black text-white px-4 py-2 border-2 border-neo-black font-mono font-bold uppercase shadow-hard hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all flex-shrink-0 text-sm md:text-base"
                    data-filter="all"
                >
                    ALL_SIGNALS
                </button>
                {
                    allTopics.map((topic) => (
                        <button
                            class="filter-btn bg-white px-4 py-2 border-2 border-neo-black font-mono font-bold uppercase shadow-hard hover:bg-neo-yellow hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all flex-shrink-0 text-sm md:text-base"
                            data-filter={topic}
                        >
                            #{topic}
                        </button>
                    ))
                }
            </div>
        </div>

        <div id="blogGrid" class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {
                allPosts.map((post) => (
                    <article
                        class="blog-card border-4 border-neo-black bg-white shadow-hard hover:shadow-none transition-all group relative overflow-hidden flex flex-col"
                        data-topics={post.topics.join(",")}
                        data-title={post.title.toLowerCase()}
                        data-excerpt={post.excerpt.toLowerCase()}
                    >
                        {/* Image Section - Clickable */}
                        <a
                            href={post.link}
                            target={post.isExternal ? "_blank" : "_self"}
                            class="block h-64 border-b-4 border-neo-black overflow-hidden relative flex-shrink-0 group-hover:brightness-110 transition-all"
                        >
                            <div class="absolute inset-0 bg-neo-purple/20 group-hover:bg-transparent transition-colors z-10" />
                            {post.coverImage && (
                                <img
                                    src={post.coverImage}
                                    alt={post.title}
                                    class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500 scale-100 group-hover:scale-110"
                                />
                            )}
                            {post.isExternal && (
                                <div class="absolute top-4 right-4 bg-black text-white text-sm font-mono px-3 py-1 z-20 border-2 border-white">
                                    MEDIUM
                                </div>
                            )}
                        </a>

                        {/* Content Section */}
                        <div class="p-8 flex-grow flex flex-col">
                            {/* Date */}
                            <div class="font-mono text-sm mb-4 bg-neo-yellow inline-block px-2 border-2 border-neo-black self-start">
                                {post.date.toLocaleDateString(
                                    lang === "id" ? "id-ID" : "en-US",
                                    {
                                        year: "numeric",
                                        month: "long",
                                        day: "numeric",
                                    },
                                )}
                            </div>

                            {/* Title & Excerpt - Clickable */}
                            <a
                                href={post.link}
                                target={post.isExternal ? "_blank" : "_self"}
                                class="block mb-6 group-hover:opacity-80 transition-opacity"
                            >
                                <h2 class="text-3xl font-bold mb-4 leading-tight group-hover:text-neo-purple transition-colors">
                                    {post.title}
                                </h2>
                                <p class="text-lg text-neo-black/80 line-clamp-3">
                                    {post.excerpt}
                                </p>
                            </a>

                            <div class="mt-auto">
                                {/* Interactive Tags */}
                                {post.topics && post.topics.length > 0 && (
                                    <div class="flex flex-wrap gap-2 mb-6 relative z-20">
                                        {post.topics
                                            .slice(0, 3)
                                            .map((topic) => (
                                                <button
                                                    class="tag-pill text-xs font-mono font-bold bg-gray-100 px-2 py-1 border border-black text-gray-600 hover:bg-neo-black hover:text-white transition-colors cursor-pointer z-50 pointer-events-auto"
                                                    data-topic={topic}
                                                    onclick={`event.preventDefault(); event.stopPropagation(); filterByTag('${topic}')`}
                                                >
                                                    #{topic}
                                                </button>
                                            ))}
                                    </div>
                                )}

                                {/* Read More Link */}
                                <a
                                    href={post.link}
                                    target={
                                        post.isExternal ? "_blank" : "_self"
                                    }
                                    class="inline-flex items-center gap-2 font-bold font-mono group-hover:translate-x-2 transition-transform"
                                >
                                    {t.readMore}{" "}
                                    <i
                                        class={`ri-${post.isExternal ? "external-link-line" : "arrow-right-line"}`}
                                    />
                                </a>
                            </div>
                        </div>
                    </article>
                ))
            }
        </div>

        {/* Empty State */}
        <div
            id="emptyState"
            class="hidden flex-col items-center justify-center py-24 text-center"
        >
            <i
                class="ri-signal-wifi-error-line text-6xl mb-4 text-neo-black opacity-50"
            ></i>
            <h3 class="text-2xl font-black uppercase font-mono">
                NO SIGNAL FOUND
            </h3>
            <p class="font-mono text-neo-black/60">
                Try adjusting your frequency (filter).
            </p>
        </div>
    </main>

    <script is:inline>
        const searchInput = document.getElementById("searchInput");
        const filterBtns = document.querySelectorAll(".filter-btn");
        const blogCards = document.querySelectorAll(".blog-card");
        const emptyState = document.getElementById("emptyState");

        // Global function for tag clicks
        window.filterByTag = (topic) => {
            // Find the button for this topic
            const btn = document.querySelector(
                `.filter-btn[data-filter="${topic}"]`,
            );
            if (btn) {
                btn.click();
                // Scroll to top of grid logic if needed, but keeping it simple for now
                setTimeout(() => {
                    document
                        .getElementById("blogGrid")
                        .scrollIntoView({ behavior: "smooth", block: "start" });
                }, 100);
            }
        };

        function filter() {
            const query = searchInput.value.toLowerCase();
            const activeBtn = document.querySelector(".filter-btn.active");
            const activeTopic = activeBtn ? activeBtn.dataset.filter : "all";
            let visibleCount = 0;

            blogCards.forEach((card) => {
                const title = card.dataset.title || "";
                const excerpt = card.dataset.excerpt || "";
                const topics = card.dataset.topics
                    ? card.dataset.topics.split(",")
                    : [];

                const matchesSearch =
                    title.includes(query) || excerpt.includes(query);
                const matchesTopic =
                    activeTopic === "all" || topics.includes(activeTopic);

                if (matchesSearch && matchesTopic) {
                    card.style.display = "flex";
                    visibleCount++;
                } else {
                    card.style.display = "none";
                }
            });

            if (visibleCount === 0) {
                emptyState.classList.remove("hidden");
                emptyState.classList.add("flex");
            } else {
                emptyState.classList.add("hidden");
                emptyState.classList.remove("flex");
            }
        }

        searchInput.addEventListener("input", filter);

        filterBtns.forEach((btn) => {
            btn.addEventListener("click", () => {
                // Update active state
                document
                    .querySelector(".filter-btn.active")
                    .classList.remove("active", "bg-neo-black", "text-white");
                document
                    .querySelector(".filter-btn.active")
                    .classList.add("bg-white");

                btn.classList.add("active", "bg-neo-black", "text-white");
                btn.classList.remove("bg-white");

                filter();
            });
        });
    </script>
</Layout>
