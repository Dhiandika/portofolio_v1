---
import Layout from "../../layouts/Layout.astro";
import CodingStatsExtended from "../../components/CodingStatsExtended.astro";
import SystemSpecs from "../../components/SystemSpecs.tsx";
import { getEntry } from "astro:content";

export async function getStaticPaths() {
    return [{ params: { lang: "en" } }, { params: { lang: "id" } }];
}

const { lang } = Astro.params;

const usesData = await getEntry("site", "uses");
const hardware = usesData?.data?.hardware || [];
const software = usesData?.data?.software || [];
const wallpaper = usesData?.data?.wallpaper || "";

const now = await getEntry("now", "data");

const ui = {
    en: {
        title: "Dashboard",
        subtitle: "System Status & Metrics",
        traffic: "Live Traffic",
        contributions: "Contribution Map",
        stack: "Tech Stack Usage",
    },
    id: {
        title: "Dasbor",
        subtitle: "Status Sistem & Metrik",
        traffic: "Trafik Langsung",
        contributions: "Peta Kontribusi",
        stack: "Penggunaan Teknologi",
    },
};

const t = ui[lang] || ui.en;
---

<Layout title={`${t.title} | Arham.exe`} lang={lang}>
    <main class="min-h-screen bg-neo-white pt-32 px-4 pb-20 bg-neo-texture">
        <div class="max-w-7xl mx-auto">
            <!-- Header -->
            <div
                class="mb-12 flex flex-col md:flex-row justify-between items-start md:items-end gap-4"
            >
                <div>
                    <h1
                        class="text-5xl md:text-7xl font-black uppercase mb-4 tracking-tighter"
                    >
                        {t.title}
                    </h1>
                    <p
                        class="font-mono text-xl md:text-2xl text-neo-black/70 border-l-4 border-black pl-4"
                    >
                        {t.subtitle}
                    </p>
                </div>
                <div class="flex items-center gap-3">
                    <a
                        href={`/${lang}/links-dashboard`}
                        class="flex items-center gap-2 font-mono font-bold bg-neo-yellow text-black px-4 py-2 border-2 border-black shadow-hard hover:bg-black hover:text-neo-yellow transition-all"
                    >
                        <i class="ri-bar-chart-box-line text-lg"></i>
                        LINK IN BIO ANALYTICS →
                    </a>
                    <div
                        class="flex items-center gap-2 font-mono font-bold bg-green-100 text-green-800 px-4 py-2 border-2 border-black shadow-hard animate-pulse"
                    >
                        <div class="w-3 h-3 bg-green-500 rounded-full"></div>
                        SYSTEM OPERATIONAL
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                <!-- System Monitor (New) -->
                <div
                    class="lg:col-span-1 bg-black text-neo-green border-2 border-black shadow-hard p-6 flex flex-col justify-between"
                >
                    <h2
                        class="text-xl font-black uppercase mb-4 flex items-center gap-2"
                    >
                        <i class="ri-cpu-line"></i> SYSTEM_MONITOR
                    </h2>
                    <div class="space-y-6">
                        <div>
                            <div
                                class="flex justify-between font-mono text-sm mb-1"
                            >
                                <span>CPU_USAGE</span>
                                <span id="cpu-text">12%</span>
                            </div>
                            <div
                                class="w-full h-4 bg-gray-800 border border-neo-green"
                            >
                                <div
                                    id="cpu-bar"
                                    class="h-full bg-neo-green transition-all duration-500"
                                    style="width: 12%"
                                >
                                </div>
                            </div>
                        </div>
                        <div>
                            <div
                                class="flex justify-between font-mono text-sm mb-1"
                            >
                                <span>MEMORY_ALLOC</span>
                                <span id="mem-text">45%</span>
                            </div>
                            <div
                                class="w-full h-4 bg-gray-800 border border-neo-green"
                            >
                                <div
                                    id="mem-bar"
                                    class="h-full bg-neo-green transition-all duration-500"
                                    style="width: 45%"
                                >
                                </div>
                            </div>
                        </div>
                        <div class="pt-4 border-t border-neo-green/30">
                            <div class="flex justify-between font-mono text-xs">
                                <span>UPTIME</span>
                                <span>42d 13h 22m</span>
                            </div>
                            <div
                                class="flex justify-between font-mono text-xs mt-1"
                            >
                                <span>REGION</span>
                                <span>ASIA-SE1</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Traffic Monitor (Chart.js) -->
                <div
                    class="lg:col-span-2 bg-white border-2 border-black shadow-hard p-6 flex flex-col"
                >
                    <div class="flex justify-between items-center mb-6">
                        <h2
                            class="text-2xl font-black uppercase flex items-center gap-2"
                        >
                            <i class="ri-pulse-line"></i>
                            {t.traffic}
                        </h2>
                        <span
                            class="font-mono text-xs bg-black text-white px-2 py-1 flex items-center gap-2"
                        >
                            <span
                                class="w-2 h-2 bg-green-500 rounded-full animate-pulse"
                            ></span> RPS: <span id="currentRps">--</span>
                        </span>
                    </div>
                    <div class="h-64 w-full">
                        <canvas id="trafficChart"></canvas>
                    </div>
                </div>

                <!-- System Specs -->
                <div class="lg:col-span-3">
                    <h2
                        class="text-2xl font-black uppercase mb-6 flex items-center gap-2"
                    >
                        <i class="ri-hard-drive-2-line"></i> SYSTEM_SPECS
                    </h2>
                    <SystemSpecs
                        client:load
                        hardware={hardware}
                        software={software}
                        wallpaper={wallpaper}
                    />
                </div>

                <!-- System Status / Now -->
                <div
                    class="lg:col-span-3 bg-white border-4 border-black shadow-hard overflow-hidden"
                >
                    <div
                        class="bg-neo-black text-white px-4 py-2 flex justify-between items-center border-b-4 border-black"
                    >
                        <span class="font-mono font-bold"
                            >TASK_MANAGER.EXE // NOW</span
                        >
                        <div class="flex gap-2">
                            <div
                                class="w-3 h-3 bg-neo-red rounded-full border border-white"
                            >
                            </div>
                            <div
                                class="w-3 h-3 bg-neo-yellow rounded-full border border-white"
                            >
                            </div>
                            <div
                                class="w-3 h-3 bg-neo-green rounded-full border border-white"
                            >
                            </div>
                        </div>
                    </div>

                    <div
                        class="grid grid-cols-12 gap-2 bg-gray-100 border-b-2 border-black px-4 py-2 font-mono font-bold text-xs md:text-sm text-gray-500"
                    >
                        <div class="col-span-2">PID</div>
                        <div class="col-span-4 md:col-span-3">PROCESS</div>
                        <div class="col-span-6 md:col-span-5">STATUS</div>
                        <div
                            class="col-span-0 md:col-span-1 hidden md:block text-right"
                        >
                            CPU%
                        </div>
                        <div
                            class="col-span-0 md:col-span-1 hidden md:block text-right"
                        >
                            MEM
                        </div>
                    </div>

                    <div class="divide-y-2 divide-gray-200 font-mono text-sm">
                        <div
                            class="grid grid-cols-12 gap-2 px-4 py-4 items-center hover:bg-neo-purple/20 transition-colors"
                        >
                            <div class="col-span-2 text-neo-purple font-bold">
                                1337
                            </div>
                            <div
                                class="col-span-4 md:col-span-3 font-bold uppercase"
                            >
                                WORKING_ON
                            </div>
                            <div class="col-span-6 md:col-span-5 truncate">
                                {now?.data?.working || "Unknown"}
                            </div>
                            <div
                                class="col-span-0 md:col-span-1 hidden md:block text-right"
                            >
                                12.4
                            </div>
                            <div
                                class="col-span-0 md:col-span-1 hidden md:block text-right"
                            >
                                256MB
                            </div>
                        </div>
                        <div
                            class="grid grid-cols-12 gap-2 px-4 py-4 items-center hover:bg-neo-green/20 transition-colors"
                        >
                            <div class="col-span-2 text-neo-blue font-bold">
                                4096
                            </div>
                            <div
                                class="col-span-4 md:col-span-3 font-bold uppercase"
                            >
                                LEARNING
                            </div>
                            <div class="col-span-6 md:col-span-5 truncate">
                                {now?.data?.learning || "Unknown"}
                            </div>
                            <div
                                class="col-span-0 md:col-span-1 hidden md:block text-right"
                            >
                                8.2
                            </div>
                            <div
                                class="col-span-0 md:col-span-1 hidden md:block text-right"
                            >
                                128MB
                            </div>
                        </div>
                        <div
                            class="grid grid-cols-12 gap-2 px-4 py-4 items-center hover:bg-neo-pink/20 transition-colors"
                        >
                            <div class="col-span-2 text-neo-orange font-bold">
                                8080
                            </div>
                            <div
                                class="col-span-4 md:col-span-3 font-bold uppercase"
                            >
                                READING
                            </div>
                            <div class="col-span-6 md:col-span-5 truncate">
                                {now?.data?.reading || "Unknown"}
                            </div>
                            <div
                                class="col-span-0 md:col-span-1 hidden md:block text-right"
                            >
                                4.1
                            </div>
                            <div
                                class="col-span-0 md:col-span-1 hidden md:block text-right"
                            >
                                64MB
                            </div>
                        </div>
                        <div
                            class="grid grid-cols-12 gap-2 px-4 py-4 items-center hover:bg-neo-blue/20 transition-colors"
                        >
                            <div class="col-span-2 text-neo-red font-bold">
                                3000
                            </div>
                            <div
                                class="col-span-4 md:col-span-3 font-bold uppercase"
                            >
                                LISTENING
                            </div>
                            <div class="col-span-6 md:col-span-5 truncate">
                                {now?.data?.listening || "Unknown"}
                            </div>
                            <div
                                class="col-span-0 md:col-span-1 hidden md:block text-right"
                            >
                                2.5
                            </div>
                            <div
                                class="col-span-0 md:col-span-1 hidden md:block text-right"
                            >
                                32MB
                            </div>
                        </div>
                    </div>
                </div>

                <!-- WakaTime (New) -->
                <div
                    class="lg:col-span-1 bg-white border-2 border-black shadow-hard p-6"
                >
                    <h2
                        class="text-xl font-black uppercase mb-4 flex items-center gap-2"
                    >
                        <i class="ri-code-box-line"></i> CODE_ACTIVITY
                    </h2>
                    <div class="h-48">
                        <canvas id="wakaChart"></canvas>
                    </div>
                    <p class="text-xs font-mono text-center mt-2 text-gray-500">
                        Weekly breakdown by language
                    </p>
                </div>

                <!-- GitHub Contributions -->
                <div
                    class="lg:col-span-2 bg-white border-2 border-black shadow-hard p-6 overflow-hidden"
                >
                    <h2
                        class="text-2xl font-black uppercase mb-6 flex items-center gap-2"
                    >
                        <i class="ri-git-commit-line"></i>
                        {t.contributions}
                    </h2>

                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
                        <div
                            class="bg-gray-100 p-2 border border-black text-center"
                        >
                            <div class="text-2xl font-black" id="gh-repos">
                                --
                            </div>
                            <div class="text-xs font-mono text-gray-600">
                                REPOSITORIES
                            </div>
                        </div>
                        <div
                            class="bg-gray-100 p-2 border border-black text-center"
                        >
                            <div class="text-2xl font-black" id="gh-followers">
                                --
                            </div>
                            <div class="text-xs font-mono text-gray-600">
                                FOLLOWERS
                            </div>
                        </div>
                        <div
                            class="bg-gray-100 p-2 border border-black text-center"
                        >
                            <div class="text-2xl font-black">1,337</div>
                            <div class="text-xs font-mono text-gray-600">
                                COMMITS (2024)
                            </div>
                        </div>
                        <div
                            class="bg-gray-100 p-2 border border-black text-center"
                        >
                            <div class="text-2xl font-black">A++</div>
                            <div class="text-xs font-mono text-gray-600">
                                RATING
                            </div>
                        </div>
                    </div>

                    <div
                        class="w-full border-2 border-gray-100 p-4 relative group overflow-x-auto"
                    >
                        <img
                            src="https://ghchart.rshah.org/33FF57/Dhiandika"
                            alt="GitHub Contribution Graph"
                            class="w-full min-w-[600px] h-auto filter grayscale group-hover:grayscale-0 transition-all duration-500"
                        />
                    </div>
                    <div class="flex justify-end mt-4">
                        <a
                            href="https://github.com/Dhiandika"
                            target="_blank"
                            class="bg-black text-white px-4 py-2 font-mono text-xs hover:bg-neo-green hover:text-black transition-colors"
                        >
                            VIEW PROFILE →
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script>
        // GitHub Stats Fetcher (Enhanced)
        async function fetchGitHubStats() {
            try {
                const response = await fetch(
                    "https://api.github.com/users/Dhiandika",
                );
                const data = await response.json();

                // Not just repo count, but we could add more if API allowed without auth
                // For now, we stick to the basics but displayed better
                const reposEl = document.getElementById("gh-repos");
                const followersEl = document.getElementById("gh-followers");

                if (reposEl) reposEl.textContent = data.public_repos || "25";
                if (followersEl)
                    followersEl.textContent = data.followers || "12";
            } catch (e) {
                console.error("GH fetch error", e);
            }
        }

        function updateSystemMonitor() {
            const cpuBar = document.getElementById("cpu-bar");
            const memBar = document.getElementById("mem-bar");
            const cpuText = document.getElementById("cpu-text");
            const memText = document.getElementById("mem-text");

            setInterval(() => {
                // Mock CPU Usage (random fluctuation)
                const cpu = Math.floor(Math.random() * 30) + 10; // 10-40%
                if (cpuBar) cpuBar.style.width = `${cpu}%`;
                if (cpuText) cpuText.textContent = `${cpu}%`;

                // Mock Memory Usage (steady climb then drop)
                const mem = Math.floor(Math.random() * 10) + 40; // 40-50%
                if (memBar) memBar.style.width = `${mem}%`;
                if (memText) memText.textContent = `${mem}%`;
            }, 2000);
        }

        // Helper to load script
        function loadScript(src) {
            return new Promise((resolve, reject) => {
                const existing = document.querySelector(`script[src="${src}"]`);
                if (existing) {
                    if (existing.dataset.loaded === "true") resolve();
                    else existing.addEventListener("load", resolve);
                    return;
                }
                const script = document.createElement("script");
                script.src = src;
                script.onload = () => {
                    script.dataset.loaded = "true";
                    resolve();
                };
                script.onerror = reject;
                document.head.appendChild(script);
            });
        }

        document.addEventListener("astro:page-load", async () => {
            fetchGitHubStats();
            updateSystemMonitor();

            try {
                await loadScript("https://cdn.jsdelivr.net/npm/chart.js");

                // Now window.Chart is available
                // @ts-ignore
                const ChartClass = window.Chart;

                initWakaTime(ChartClass);

                const ctx = document.getElementById("trafficChart");
                const rpsEl = document.getElementById("currentRps");

                if (ctx && ctx instanceof HTMLCanvasElement) {
                    // Initialize Data with a baseline
                    const initialData = Array.from(
                        { length: 30 },
                        () => 40 + Math.random() * 10,
                    );

                    // Chart.js simulation
                    const chart = new ChartClass(ctx, {
                        type: "line",
                        data: {
                            labels: Array.from({ length: 30 }, (_, i) => i),
                            datasets: [
                                {
                                    label: "Requests/Sec",
                                    data: initialData,
                                    borderColor: "#33FF57",
                                    backgroundColor: (context) => {
                                        const ctx = context.chart.ctx;
                                        const gradient =
                                            ctx.createLinearGradient(
                                                0,
                                                0,
                                                0,
                                                300,
                                            );
                                        gradient.addColorStop(
                                            0,
                                            "rgba(51, 255, 87, 0.4)",
                                        );
                                        gradient.addColorStop(
                                            1,
                                            "rgba(51, 255, 87, 0)",
                                        );
                                        return gradient;
                                    },
                                    borderWidth: 2,
                                    tension: 0.4,
                                    fill: true,
                                    pointRadius: 0,
                                },
                            ],
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            animation: false,
                            scales: {
                                x: { display: false },
                                y: {
                                    display: true,
                                    min: 0,
                                    max: 100,
                                    grid: { color: "#333" },
                                    ticks: {
                                        color: "#33FF57",
                                        font: { family: "monospace" },
                                        stepSize: 20,
                                    },
                                },
                            },
                            plugins: { legend: { display: false } },
                        },
                    });

                    // Simulation Interval
                    const interval = setInterval(() => {
                        if (!document.getElementById("trafficChart")) {
                            clearInterval(interval);
                            return;
                        }

                        const data = chart.data.datasets[0].data;
                        const lastVal = data[data.length - 1];

                        // Smooth Random Walk
                        let change = (Math.random() - 0.5) * 10;
                        let newVal = lastVal + change;

                        if (newVal > 80) newVal = 80 - Math.abs(change);
                        if (newVal < 20) newVal = 20 + Math.abs(change);

                        data.shift();
                        data.push(newVal);
                        chart.update("none");

                        if (rpsEl)
                            rpsEl.textContent = Math.round(newVal).toString();
                    }, 1000);
                }
            } catch (e) {
                console.error("Failed to load Chart.js", e);
            }
        });

        function initWakaTime(ChartClass) {
            const ctx = document.getElementById("wakaChart");
            if (ctx && ctx instanceof HTMLCanvasElement) {
                new ChartClass(ctx, {
                    type: "doughnut",
                    data: {
                        labels: [
                            "TypeScript",
                            "Astro",
                            "Python",
                            "CSS/HTML",
                            "Other",
                        ],
                        datasets: [
                            {
                                data: [45, 25, 15, 10, 5],
                                backgroundColor: [
                                    "#3178C6", // TS Blue
                                    "#FF5D01", // Astro Orange
                                    "#3776AB", // Python Blue
                                    "#E34F26", // HTML Red
                                    "#808080", // Grey
                                ],
                                borderWidth: 2,
                                borderColor: "#000",
                            },
                        ],
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: "right",
                                labels: {
                                    font: { family: "monospace" },
                                    color: "#000",
                                },
                            },
                        },
                    },
                });
            }
        }
    </script>

    <style>
        .stripe-pattern {
            background-image: linear-gradient(
                45deg,
                rgba(0, 0, 0, 0.1) 25%,
                transparent 25%,
                transparent 50%,
                rgba(0, 0, 0, 0.1) 50%,
                rgba(0, 0, 0, 0.1) 75%,
                transparent 75%,
                transparent
            );
            background-size: 10px 10px;
        }
    </style>
</Layout>
