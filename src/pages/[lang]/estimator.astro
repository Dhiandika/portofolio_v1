---
import Layout from "../../layouts/Layout.astro";
import EstimatorWrapper from "../../components/Estimator.tsx";
import { getEntry } from "astro:content";

export async function getStaticPaths() {
    return [{ params: { lang: "en" } }, { params: { lang: "id" } }];
}

const { lang } = Astro.params;
const siteConfig = await getEntry("site", "config");
const estimatorData = await getEntry("site", "estimator");

const services = estimatorData?.data?.services || [];
const currencySymbol = estimatorData?.data?.currencySymbol || "$";

const t = {
    en: {
        title: "PROJECT ESTIMATOR",
        subtitle: "Calculate your project cost.",
    },
    id: {
        title: "ESTIMATOR PROYEK",
        subtitle: "Hitung biaya proyek Anda.",
    },
};

const text = t[lang as keyof typeof t] || t.en;
---

<Layout title={`ESTIMATOR | ${siteConfig.data.brandName}`} lang={lang}>
    <main class="pt-32 pb-24 px-4 max-w-6xl mx-auto min-h-screen">
        <header data-aos="fade-up" class="mb-16 text-center">
            <h1
                class="text-4xl md:text-6xl font-black uppercase mb-4 tracking-tighter"
            >
                {text.title}
            </h1>
            <p
                class="font-mono text-xl bg-neo-yellow text-black inline-block px-4 py-2 font-bold border-2 border-black shadow-hard transform -rotate-1"
            >
                {text.subtitle}
            </p>
        </header>

        <section data-aos="fade-up" data-aos-delay="100">
            <Estimator client:load services={services} currencySymbol={currencySymbol} />
        </section>

        <div class="mt-12 text-center">
            <a
                href={`/${lang}`}
                class="inline-block font-mono font-bold text-gray-500 hover:text-black border-b-2 border-transparent hover:border-black transition-all"
            >
                &larr; RETURN_HOME
            </a>
        </div>
    </main>
</Layout>
