---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
    return [{ params: { lang: "en" } }, { params: { lang: "id" } }];
}

const { lang } = Astro.params;
const allProjects = await getCollection("projects");
// Sort by 'order' field (ascending) — lower number = shown first, default 99
const projects = allProjects.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const ui: any = {
    en: {
        title: "Projects",
        subtitle: "Curated Works & Experiments",
        search: "Search projects...",
        all: "All",
        web: "Web",
        mobile: "Mobile",
        uiux: "UI/UX",
        other: "Other",
        view: "View Detail",
    },
    id: {
        title: "Proyek",
        subtitle: "Karya Terpilih & Eksperimen",
        search: "Cari proyek...",
        all: "Semua",
        web: "Web",
        mobile: "Mobile",
        uiux: "UI/UX",
        other: "Lainnya",
        view: "Lihat Detail",
    },
};

const t = ui[lang as string] || ui.en;
---

<Layout title={`${t.title} | Arham.exe`} lang={lang}>
    <main class="min-h-screen text-neo-black pt-32 px-4 pb-20 border-t-8 border-black">
        <div class="max-w-7xl mx-auto">
            <!-- Header -->
            <div data-aos="fade-up" class="mb-12">
                <h1
                    class="text-5xl md:text-7xl font-black uppercase mb-4 tracking-tighter text-neo-black"
                >
                    {t.title}
                </h1>
                <p
                    class="font-mono text-xl md:text-2xl text-neo-black/70 border-l-4 border-neo-green pl-4"
                >
                    {t.subtitle}
                </p>
            </div>

            <!-- Controls -->
            <div
                class="flex flex-col md:flex-row gap-4 mb-12 sticky top-28 z-[90] bg-neo-white py-4 border-b-4 border-black/10"
            >
                <div class="relative flex-grow">
                    <i
                        class="ri-search-line absolute left-4 top-1/2 -translate-y-1/2 text-xl opacity-50 text-black"
                    ></i>
                    <input
                        type="text"
                        id="searchInput"
                        placeholder={t.search}
                        class="w-full bg-white text-black border-4 border-black p-4 pl-12 font-mono shadow-[6px_6px_0_0_#000] focus:outline-none focus:shadow-none focus:translate-x-1 focus:translate-y-1 transition-all"
                    />
                </div>
                <div
                    class="flex gap-2 overflow-x-auto pb-2 md:pb-0 scrollbar-hide"
                >
                    <button
                        class="filter-btn active bg-black text-white px-6 py-4 border-4 border-black font-black uppercase shadow-[6px_6px_0_0_#000] hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all flex-shrink-0"
                        data-filter="all">{t.all}</button
                    >
                    <button
                        class="filter-btn bg-white text-black px-6 py-4 border-4 border-black font-black uppercase shadow-[6px_6px_0_0_#000] hover:bg-neo-yellow hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all flex-shrink-0"
                        data-filter="Web">{t.web}</button
                    >
                    <button
                        class="filter-btn bg-white text-black px-6 py-4 border-4 border-black font-black uppercase shadow-[6px_6px_0_0_#000] hover:bg-neo-blue hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all flex-shrink-0"
                        data-filter="Mobile">{t.mobile}</button
                    >
                    <button
                        class="filter-btn bg-white text-black px-6 py-4 border-4 border-black font-black uppercase shadow-[6px_6px_0_0_#000] hover:bg-neo-pink hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all flex-shrink-0"
                        data-filter="UI/UX">{t.uiux}</button
                    >
                    <button
                        class="filter-btn bg-white text-black px-6 py-4 border-4 border-black font-black uppercase shadow-[6px_6px_0_0_#000] hover:bg-neo-green hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all flex-shrink-0"
                        data-filter="Other">{t.other}</button
                    >
                </div>
            </div>

            <!-- Grid -->
            <div
                id="projectGrid"
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
            >
                {
                    projects.map((project, index) => {
                        const title = lang === "id" ? project.data.title_id || project.data.title : project.data.title;
                        const desc = lang === "id" ? project.data.description_id || project.data.description : project.data.description;
                        const detailHref = `/${lang}/projects/${project.id}`;

                        const tags = project.data.techStack
                            ? project.data.techStack.join(" ").toLowerCase()
                            : "";
                        let category = project.data.category || "Other";
                        if (!project.data.category) {
                            if (tags.includes("react") || tags.includes("astro") || tags.includes("web") || tags.includes("js")) category = "Web";
                            else if (tags.includes("flutter") || tags.includes("native") || tags.includes("android")) category = "Mobile";
                            else if (tags.includes("figma") || tags.includes("design")) category = "UI/UX";
                        }
                        
                        const categoryIcons: any = { "Web": "ri-global-line", "Mobile": "ri-smartphone-line", "UI/UX": "ri-pen-nib-line", "Other": "ri-code-s-slash-line" };
                        const catIcon = categoryIcons[category] || "ri-code-s-slash-line";
                        
                        const DESC_LIMIT = 90;
                        const shortDesc = desc && desc.length > DESC_LIMIT
                            ? desc.slice(0, DESC_LIMIT).trimEnd() + "..."
                            : desc;

                        return (
                            <article
                                data-aos="fade-up"
                                data-aos-delay={String(index % 3 * 80)}
                                class="project-card group border-4 border-black bg-white shadow-[6px_6px_0_0_#000] hover:shadow-[10px_10px_0_0_#FBFF48] hover:border-neo-yellow transition-all duration-300 flex flex-col overflow-hidden h-full"
                                data-category={category}
                                data-title={title.toLowerCase()}
                            >
                                <a href={detailHref} class="flex flex-col flex-1 h-full hover:no-underline">
                                    <div class="relative h-48 overflow-hidden border-b-4 border-black group-hover:border-neo-yellow transition-colors">
                                        {project.data.image ? (
                                            <img
                                                src={project.data.image}
                                                alt={title}
                                                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                                                onerror="this.onerror=null;this.style.opacity='0';"
                                            />
                                        ) : (
                                            <div class="w-full h-full flex items-center justify-center bg-gray-100 text-black/20">
                                                <i class="ri-code-s-slash-line text-6xl" />
                                            </div>
                                        )}
                                        <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
                                        <span class="absolute top-3 left-3 flex items-center gap-1 bg-neo-yellow text-black text-[10px] font-black px-2 py-1 uppercase tracking-widest border-2 border-black z-10 hover:bg-white transition-colors" onclick={`event.preventDefault(); event.stopPropagation(); filterByCategory('${category}')`}>
                                            <i class={catIcon + " text-xs"}></i> {category}
                                        </span>
                                    </div>
                                    <div class="flex flex-col flex-1 p-5">
                                        <h3 class="text-xl font-black text-neo-black uppercase leading-tight mb-2 group-hover:text-neo-yellow transition-colors line-clamp-2">
                                            {title}
                                        </h3>
                                        
                                        <div class="flex flex-wrap gap-1.5 mb-3">
                                            {project.data.techStack &&
                                                project.data.techStack
                                                    .slice(0, 3)
                                                    .map((tech: any) => (
                                                        <span class="text-[9px] font-mono font-bold border border-black/20 bg-gray-100 text-neo-black/70 px-2 py-0.5">
                                                            #{tech}
                                                        </span>
                                                    ))}
                                            {project.data.techStack && project.data.techStack.length > 3 && (
                                                <span class="text-[9px] font-mono font-bold border border-black/20 bg-gray-100 text-neo-black/70 px-2 py-0.5">
                                                    +{project.data.techStack.length - 3}
                                                </span>
                                            )}
                                        </div>

                                        <p class="font-mono text-neo-black/70 text-[11px] leading-relaxed mb-4 flex-1">
                                            {shortDesc}
                                        </p>

                                        <div class="mt-auto border-t-2 border-black/10 pt-3 flex justify-between items-center">
                                            <span class="font-black text-[11px] uppercase tracking-widest text-neo-black/50 group-hover:text-neo-yellow transition-colors">Read more</span>
                                            <div class="flex gap-2">
                                                {project.data.githubLink ? (
                                                    <a href={project.data.githubLink} target="_blank" class="w-8 h-8 rounded-full bg-black/5 border border-black/10 flex items-center justify-center text-black/50 hover:bg-neo-yellow hover:text-black hover:border-neo-yellow transition-all cursor-pointer z-10" onclick="event.stopPropagation()">
                                                        <i class="ri-github-fill"></i>
                                                    </a>
                                                ) : project.data.link ? (
                                                    <a href={project.data.link} target="_blank" class="w-8 h-8 rounded-full bg-black/5 border border-black/10 flex items-center justify-center text-black/50 hover:bg-neo-yellow hover:text-black hover:border-neo-yellow transition-all cursor-pointer z-10" onclick="event.stopPropagation()">
                                                        <i class="ri-external-link-line"></i>
                                                    </a>
                                                ) : null}
                                                <div class="w-8 h-8 rounded-full bg-black border border-black flex items-center justify-center text-white group-hover:bg-neo-yellow group-hover:text-black group-hover:border-neo-yellow transition-all">
                                                    <i class="ri-arrow-right-line group-hover:translate-x-0.5 transition-transform"></i>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            </article>
                        );
                    })
                }
            </div>

            <!-- Empty State -->
            <div
                id="emptyState"
                class="hidden flex-col items-center justify-center py-24 text-center"
            >
                <i class="ri-folder-unknow-line text-6xl mb-4 text-black/20"
                ></i>
                <h3 class="text-2xl font-black uppercase text-neo-black">No projects found</h3>
                <p class="font-mono text-neo-black/60">Try adjusting your search or filter.</p>
            </div>
        </div>
    </main>

    <script is:inline>
        const searchInput = document.getElementById("searchInput");
        const filterBtns = document.querySelectorAll(".filter-btn");
        const cards = document.querySelectorAll(".project-card");
        const emptyState = document.getElementById("emptyState");

        function filter() {
            const query = searchInput.value.toLowerCase();
            const activeCategory = document.querySelector(
                ".filter-btn.active",
            ).dataset.filter;
            let visibleCount = 0;

            cards.forEach((card) => {
                const title = card.dataset.title || "";
                const category = card.dataset.category || "";

                const matchesSearch = title.includes(query);
                const matchesCategory =
                    activeCategory === "all" || category === activeCategory;

                if (matchesSearch && matchesCategory) {
                    card.style.display = "flex";
                    visibleCount++;
                } else {
                    card.style.display = "none";
                }
            });

            emptyState.style.display = visibleCount === 0 ? "flex" : "none";
        }

        searchInput.addEventListener("input", filter);

        filterBtns.forEach((btn) => {
            btn.addEventListener("click", () => {
                document
                    .querySelector(".filter-btn.active")
                    .classList.remove("active", "bg-black", "text-white");
                document
                    .querySelector(".filter-btn.active")
                    .classList.add("bg-white", "text-black");

                btn.classList.add("active", "bg-black", "text-white");
                btn.classList.remove("bg-white");

                filter();
            });
        });
        
        function filterByCategory(category) {
            const btns = document.querySelectorAll('.filter-btn');
            btns.forEach(btn => {
                if(btn.dataset.filter === category) {
                    btn.click();
                }
            });
        }
    </script>
</Layout>
