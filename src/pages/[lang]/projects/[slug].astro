    ---
import Layout from "../../../layouts/Layout.astro";
import { getCollection, getEntry } from "astro:content";
import { getTechIcon, getTechColor, getTechAbbrev } from "../../../utils/techIcons";
import { Image, getImage } from "astro:assets";

const projectDetailImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/**/*.{jpeg,jpg,png,gif,webp}');

export const prerender = true;

export async function getStaticPaths() {
    const allProjects = await getCollection("projects");
    const projects = allProjects.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
    const paths: { params: { lang: string; slug: string }; props: { project: any } }[] = [];
    projects.forEach((project) => {
        paths.push({ params: { lang: "en", slug: project.id }, props: { project } });
        paths.push({ params: { lang: "id", slug: project.id }, props: { project } });
    });
    return paths;
}

const { lang } = Astro.params;
const { project } = Astro.props;
const siteConfig = await getEntry("site", "config");
const brandName = siteConfig?.data?.brandName || "Dhiandika";

const title = lang === "id" ? project.data.title_id || project.data.title : project.data.title;
const description = lang === "id" ? project.data.description_id || project.data.description : project.data.description;
const content = lang === "id" ? project.data.content_id || project.data.content : project.data.content;
const keyFeatures: string[] = (lang === "id" ? project.data.keyFeatures_id || project.data.keyFeatures : project.data.keyFeatures) || [];

const galleryImages: string[] = (project.data.gallery?.filter((g: string | null) => g !== null) as string[] ?? []).length
    ? (project.data.gallery!.filter((g: string | null) => g !== null) as string[])
    : project.data.image ? [project.data.image] : [];
const techIconsList = (project.data.techStack as string[]).map((tech) => ({ name: tech, icon: getTechIcon(tech) }));

const categoryIcons: Record<string, string> = {
    "Web":    "ri-global-line",
    "Mobile": "ri-smartphone-line",
    "UI/UX":  "ri-pen-nib-line",
    "Other":  "ri-code-s-slash-line",
};
const category = project.data.category || "Web";
const catIcon = categoryIcons[category] || "ri-code-s-slash-line";

// Resolve gallery images via glob
const resolvedGallery = await Promise.all(
    galleryImages.map(async (imgPath: string) => {
        const promise = projectDetailImages[imgPath];
        if (promise) {
            const mod = await promise();
            return mod.default;
        }
        return null;
    })
);
const validGallery = resolvedGallery.filter(Boolean) as ImageMetadata[];
// For client-side JS gallery navigation, collect the resolved .src URLs
const gallerySrcUrls = validGallery.map(img => img.src);
---

<Layout title={`${title} | ${brandName}`} lang={lang} image={validGallery.length > 0 ? validGallery[0].src : undefined}>
<main class="min-h-screen text-neo-black pt-24 lg:pl-14 pb-24 font-sans border-t-8 border-black">
    <div class="max-w-7xl mx-auto px-6 md:px-12">

        <!-- Breadcrumb / Back -->
        <nav class="flex items-center gap-3 text-neo-black/60 text-xs font-black uppercase tracking-widest py-6 mb-4">
            <a href={`/${lang}`} class="flex items-center gap-2 hover:text-black transition-colors border-2 border-black/20 px-4 py-2 hover:bg-black hover:text-white">
                <i class="ri-arrow-left-line"></i> Back
            </a>
            <span class="text-neo-black/40">Projects</span>
            <i class="ri-arrow-right-s-line text-neo-black/40"></i>
            <span class="text-black truncate max-w-[200px] bg-neo-yellow px-2 py-1 border-2 border-black shadow-[4px_4px_0_0_#000]">{title}</span>
        </nav>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start mt-4">

            <!-- ══════ LEFT: Info ══════ -->
            <div class="lg:col-span-5 flex flex-col gap-6">
                <!-- Title -->
                <div>
                    <span class="inline-flex items-center gap-1.5 border-2 border-black bg-neo-yellow px-3 py-1 text-[11px] font-black uppercase tracking-widest text-black mb-4 shadow-[4px_4px_0_0_#000]">
                        <i class={catIcon}></i> {category}
                    </span>
                    <h1 class="text-4xl md:text-5xl lg:text-6xl font-black leading-none text-neo-black uppercase tracking-tighter mb-4">
                        {title}
                    </h1>
                    <div class="h-2 w-24 bg-neo-green border-2 border-black shadow-[4px_4px_0_0_#000] mb-6"></div>
                    <!-- Description -->
                    <p class="text-neo-black font-mono text-sm leading-relaxed mb-4">
                        {description}
                    </p>
                    {content && (
                        <div class="border-l-4 border-neo-yellow pl-5 mb-8 bg-black/5 py-3 pr-3">
                            <p class="text-neo-black font-mono text-sm leading-relaxed whitespace-pre-line">{content}</p>
                        </div>
                    )}
                </div>

                <!-- Action Buttons -->
                <div class="flex flex-wrap gap-4 mt-2">
                    {project.data.link && (
                        <a
                            href={project.data.link}
                            target="_blank"
                            class="flex items-center gap-2 px-6 py-4 border-4 border-black bg-neo-blue text-white text-sm font-black uppercase tracking-widest hover:bg-white hover:text-black transition-all shadow-[6px_6px_0_0_#000] hover:shadow-none hover:translate-x-1 hover:translate-y-1"
                        >
                            <i class="ri-external-link-line"></i> Live Demo
                        </a>
                    )}
                    {project.data.githubLink ? (
                        <a
                            href={project.data.githubLink}
                            target="_blank"
                            class="flex items-center gap-2 px-6 py-4 border-4 border-black bg-white text-black text-sm font-black uppercase tracking-widest hover:bg-neo-yellow hover:text-black transition-all shadow-[6px_6px_0_0_#000] hover:shadow-none hover:translate-x-1 hover:translate-y-1"
                        >
                            <i class="ri-github-fill"></i> Github
                        </a>
                    ) : (
                        <span class="flex items-center gap-2 px-6 py-4 border-4 border-black/20 bg-black/5 text-neo-black/30 text-sm font-black uppercase tracking-widest cursor-not-allowed">
                            <i class="ri-github-fill"></i> Private Repo
                        </span>
                    )}
                </div>

                <!-- Technologies Used -->
                <div class="mt-8">
                    <h3 class="flex items-center gap-2 text-neo-black font-black uppercase tracking-widest text-sm mb-4 border-b-2 border-black/10 pb-3">
                        <i class="ri-cpu-line text-neo-blue"></i> Technologies Used
                    </h3>
                    <div class="flex flex-wrap gap-2">
                        {project.data.techStack?.map((tech: string) => {
                            const icon = getTechIcon(tech);
                            const color = getTechColor(tech);
                            const abbrev = getTechAbbrev(tech);
                            return (
                                <div
                                    class="tech-pill group flex items-center gap-2 bg-white border-2 border-black px-3 py-2 shadow-[3px_3px_0_0_#000] hover:shadow-none hover:translate-x-[3px] hover:translate-y-[3px] transition-all cursor-default"
                                    style={`--tech-bg:${color.bg};--tech-text:${color.text};`}
                                    title={tech}
                                >
                                    {/* Icon layer: colored badge as base, CDN icon on top */}
                                    <div
                                        class="w-6 h-6 flex-shrink-0 flex items-center justify-center border border-black/20 text-[9px] font-black"
                                        style={`background:${color.bg}; color:${color.text};`}
                                        data-abbrev={abbrev}
                                    >
                                        {icon ? (
                                            <img
                                                src={icon}
                                                alt={tech}
                                                class="w-5 h-5 object-contain"
                                                onerror={`this.style.display='none';this.parentElement.textContent=this.parentElement.dataset.abbrev;`}
                                                loading="lazy"
                                            />
                                        ) : abbrev}
                                    </div>
                                    <span class="text-[11px] font-black uppercase tracking-wide text-neo-black">{tech}</span>
                                </div>
                            );
                        })}
                    </div>
                </div>
            </div>

            <!-- ══════ RIGHT: Gallery + Key Features ══════ -->
            <div class="lg:col-span-7 flex flex-col gap-8">
                <!-- Main Image -->
                {validGallery.length > 0 && (
                    <div class="relative border-4 border-black bg-white shadow-[10px_10px_0_0_#000] group">
                        <img
                            id="main-gallery-img"
                            src={validGallery[0].src}
                            alt={title}
                            width={validGallery[0].width}
                            height={validGallery[0].height}
                            class="w-full h-auto object-cover transition-opacity duration-300"
                        />
                        {validGallery.length > 1 && (
                            <>
                                <button
                                    class="absolute left-4 top-1/2 -translate-y-1/2 w-12 h-12 bg-white text-black flex items-center justify-center border-4 border-black hover:bg-neo-yellow hover:text-black transition-all z-10 shadow-[4px_4px_0_0_#000] hover:shadow-none hover:translate-x-1 hover:translate-y-1"
                                    onclick="galleryPrev()"
                                ><i class="ri-arrow-left-s-line text-2xl font-black"></i></button>
                                <button
                                    class="absolute right-4 top-1/2 -translate-y-1/2 w-12 h-12 bg-white text-black flex items-center justify-center border-4 border-black hover:bg-neo-yellow hover:text-black transition-all z-10 shadow-[4px_4px_0_0_#000] hover:shadow-none hover:translate-x-1 hover:translate-y-1"
                                    onclick="galleryNext()"
                                ><i class="ri-arrow-right-s-line text-2xl font-black"></i></button>
                                <div class="absolute bottom-4 right-4 bg-white text-black text-[10px] font-black uppercase px-3 py-1 border-2 border-black shadow-[4px_4px_0_0_#000]">
                                    <span id="gallery-counter">1</span> / {validGallery.length}
                                </div>
                            </>
                        )}
                    </div>
                )}

                <!-- Thumbnail strip -->
                {validGallery.length > 1 && (
                    <div class="flex gap-4 overflow-x-auto pb-4 scrollbar-hide">
                        {validGallery.map((img, i) => (
                            <button
                                id={`thumb-${i}`}
                                class={`flex-shrink-0 w-24 h-16 transition-all border-4 hover:-translate-y-1 shadow-[4px_4px_0_0_#000] ${i === 0 ? "border-neo-yellow bg-neo-yellow" : "border-black bg-white opacity-60 hover:opacity-100"}`}
                                onclick={`setGalleryImage('${img.src}', ${i}, ${validGallery.length})`}
                            >
                                <img src={img.src} class="w-full h-full object-cover" loading="lazy" />
                            </button>
                        ))}
                    </div>
                )}

                <!-- Key Features -->
                {keyFeatures && keyFeatures.length > 0 && (
                    <div class="border-4 border-black bg-white p-6 md:p-8 shadow-[10px_10px_0_0_#3BFF7E]">
                        <h3 class="flex items-center gap-3 font-black text-xl uppercase mb-6 text-neo-black">
                            <i class="ri-star-fill text-neo-yellow border border-black shadow-[2px_2px_0_0_#000]"></i> Key Features
                        </h3>
                        <ul class="space-y-4">
                            {keyFeatures.map((feat: any) => (
                                <li class="flex items-start gap-4 text-sm text-neo-black/80 font-mono leading-relaxed">
                                    <span class="w-2 h-2 bg-neo-yellow mt-1.5 border border-black flex-shrink-0"></span>
                                    {feat}
                                </li>
                            ))}
                        </ul>
                    </div>
                )}
            </div>
        </div>
    </div>
</main>

<script is:inline define:vars={{ gallerySrcUrls }}>
    let currentIndex = 0;
    const _images = gallerySrcUrls || [];

    function setGalleryImage(src, index, total) {
        if (!_images.length) return;
        currentIndex = index;
        const img = document.getElementById('main-gallery-img');
        const counter = document.getElementById('gallery-counter');
        if (img) {
            img.style.opacity = '0.5';
            setTimeout(() => { img.src = src; img.style.opacity = '1'; }, 150);
        }
        if (counter) counter.textContent = index + 1;
        document.querySelectorAll('[id^="thumb-"]').forEach((b, i) => {
            if (i === index) {
                b.classList.add('border-neo-yellow', 'bg-neo-yellow');
                b.classList.remove('border-black', 'bg-white', 'opacity-60');
            } else {
                b.classList.remove('border-neo-yellow', 'bg-neo-yellow');
                b.classList.add('border-black', 'bg-white', 'opacity-60');
            }
        });
    }
    window.setGalleryImage = setGalleryImage;
    window.galleryNext = () => {
        if (!_images.length) return;
        const next = (currentIndex + 1) % _images.length;
        setGalleryImage(_images[next], next, _images.length);
    };
    window.galleryPrev = () => {
        if (!_images.length) return;
        const prev = (currentIndex - 1 + _images.length) % _images.length;
        setGalleryImage(_images[prev], prev, _images.length);
    };
</script>
</Layout>
