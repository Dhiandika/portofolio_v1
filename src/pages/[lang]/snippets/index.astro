---
import Layout from "../../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { getEntry } from "astro:content";

export async function getStaticPaths() {
    return [{ params: { lang: "en" } }, { params: { lang: "id" } }];
}

const { lang } = Astro.params;
const siteConfig = await getEntry("site", "config");
const { data: siteData } = siteConfig || { data: { brandName: "ARHAM" } };

const snippets = await getCollection("snippets");
const sortedSnippets = snippets.sort(
    (a, b) =>
        new Date(b.data.publishedDate).valueOf() -
        new Date(a.data.publishedDate).valueOf(),
);

const ui = {
    en: {
        title: "CODE SNIPPETS",
        description: "Useful bits of code for copy-pasting.",
    },
    id: {
        title: "POTONGAN KODE",
        description: "Kode berguna untuk copy-paste.",
    },
};

const t = ui[lang as keyof typeof ui] || ui.en;
---

<Layout title={`${t.title} | ${siteData.brandName}`} lang={lang}>
    <main
        class="min-h-screen pt-32 pb-20 px-4 md:px-8 bg-neo-white bg-neo-texture"
    >
        <div class="max-w-4xl mx-auto">
            <header class="mb-12 text-center">
                <h1
                    class="text-5xl md:text-7xl font-black mb-4 uppercase tracking-tighter mix-blend-darken"
                >
                    {t.title}
                </h1>
                <p
                    class="text-xl font-mono bg-neo-black text-neo-green inline-block px-4 py-2 rotate-[-1deg]"
                >
                    {t.description}
                </p>
            </header>

            <div class="grid gap-12">
                {
                    sortedSnippets.map(async (snippet) => {
                        const { Content } = await snippet.render();
                        return (
                            <article class="bg-white border-4 border-neo-black shadow-hard p-6 md:p-8 relative group">
                                <div class="absolute -top-4 -left-4 bg-neo-yellow border-2 border-neo-black px-3 py-1 font-black shadow-sm z-10 rotate-2 group-hover:-rotate-2 transition-transform">
                                    {snippet.data.tags?.[0] || "CODE"}
                                </div>

                                <div class="mb-6">
                                    <h2 class="text-3xl font-black uppercase mb-2 group-hover:text-neo-blue transition-colors">
                                        {snippet.data.title}
                                    </h2>
                                    <p class="font-mono text-gray-600 border-l-4 border-neo-purple pl-4">
                                        {snippet.data.description}
                                    </p>
                                </div>

                                <div class="relative prose prose-lg prose-pre:bg-neo-black prose-pre:text-neo-green prose-pre:border-2 prose-pre:border-black prose-pre:shadow-hard prose-pre:rounded-none max-w-none">
                                    <Content />
                                    <button
                                        class="copy-btn absolute top-4 right-4 bg-white text-black border-2 border-black px-2 py-1 font-mono text-xs hover:bg-neo-green hover:shadow-hard transition-all z-20"
                                        aria-label="Copy Code"
                                    >
                                        COPY
                                    </button>
                                </div>
                            </article>
                        );
                    })
                }
            </div>
        </div>
    </main>
</Layout>

<script>
    document.querySelectorAll(".copy-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
            const pre =
                btn.nextElementSibling ||
                btn.parentElement?.querySelector("pre");
            if (pre) {
                const code = pre.innerText;
                navigator.clipboard.writeText(code).then(() => {
                    const originalText = btn.innerText;
                    btn.innerText = "COPIED!";
                    btn.classList.add("bg-neo-green");
                    setTimeout(() => {
                        btn.innerText = originalText;
                        btn.classList.remove("bg-neo-green");
                    }, 2000);
                });
            }
        });
    });
</script>
